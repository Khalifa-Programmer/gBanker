                            jr_sender_json.push({ "Sl": inner_increment, "OfficeID": officeID, "AccID": _br_accID, "AccName": (_br_acc_code + " " + _br_acc_name), "Narration": `Fund Send to ${rec_off_code}`, "Debit": 0, "Credit": total_amt })
                            htm_body += `<tr><td style="text-align:center;">${inner_increment}</td><td>${(_br_acc_code + " " + _br_acc_name)}</td><td>Fund Send to ${rec_off_code}</td><td style="text-align:right;">0</td><td style="text-align:right;">${total_amt}</td></tr>`;

                            var htm_foot = `<tfoot><tr class="tFoot"><td>&nbsp;</td><td>&nbsp;</td><td style="text-align:right;">Total Amount</td><td style="text-align:right;">${total_amt}</td><td style="text-align:right;">${total_amt}</td></tr></tfoot>`;
                            htm_body += "</tbody>"

                            htm += `<div style="font-weight: bold;font-size: 18px;">Sender Voucher Office:${officecode + " " + officeName}</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;

                            // HO Voucher
                            var jr_receiver = jr_receiver_json.filter(function (element) { return element.Credit > 0; });
                            jr_receiver_json = [], inner_increment = 0, total_amt = 0;;
                            htm_body = "<tbody>"
                            $.each(jr_receiver, function (index, value) {
                                inner_increment += 1;
                                jr_receiver_json.push({ "Sl": inner_increment, "OfficeID": officeID, "AccID": value.AccID, "AccName": value.AccName, "Narration": Narration, "Debit": 0, "Credit": value.Credit });
                                htm_body += `<tr><td style="text-align:center;">${inner_increment}</td><td>${value.AccName}</td><td>${value.Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${value.Credit}</td></tr>`;
                                total_amt += parseFloat(value.Credit);
                            });
                            total_amt += parseFloat(amt);
                            inner_increment += 1;
                            jr_receiver_json.push({ "Sl": (inner_increment), "OfficeID": $("#ddlReceiverOfficeId").val(), "AccID": data.acc.AccID, "AccName": s_acc_name , "Narration": Narration, "Debit": 0, "Credit": amt })
                            htm_body += `<tr><td style="text-align:center;">${inner_increment}</td><td>${s_acc_name}</td><td>${Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${amt}</td></tr>`;
                            inner_increment += 1;
                            jr_receiver_json.push({ "Sl": (inner_increment), "OfficeID": $("#ddlReceiverOfficeId").val(), "AccID": _ho_accID, "AccName": (_ho_acc_code + " " + _ho_acc_name), "Narration": `Fund Received from ${officecode}`,"Debit": total_amt, "Credit": 0 })
                            htm_body += `<tr><td style="text-align:center;">${inner_increment}</td><td>${(_ho_acc_code + " " + _ho_acc_name)}</td><td>Fund Received from ${officecode}</td><td style="text-align:right;">${total_amt}</td><td style="text-align:right;">0</td></tr>`;

                            htm_body += "</tbody>"


                            htm += `<div style="font-weight: bold;font-size: 18px;">Receiver Voucher Office:${ReceiverOffice}</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;
                            $("#txtAccCode,#AccID,#Amount,#Narration").val('')
                            $("#dvInnerTable").html(htm);
                            $('#btnCreate').prop("disabled", false)
                            $("#loading").hide();
                            $("#DivTableView").show();
                            $('#TransactionType,#ddlReceiverOfficeId').prop("disabled", true);
                            
                        }
                        else {
                            $("#loading").hide();
                            $("#dvMessage").attr('class', 'failed');
                            $("#dvMessage").html('Fund Accound Mapping not found');
                            $("#dvMessage").show();
                        }
                    }
                }
            }
        }

        function BankVoucherGenerate() {
            var amt = $("#Amount").val();
            var htm = "", htm_body = "";
            if ($("#SenderBankAccId").val() && $("#ReceiverOfficeId").val() && $("#ReceiverBankAccId").val() && $("#Amount").val() && $("#Narration").val()) {


                var SenderBankAccId = $("#SenderBankAccId").val();
                var SenderBankAccName = $("#SenderBankAccId option:selected").text()
                var SenderBankAccId = $("#SenderBankAccId").val();
                var ReceiverOfficeId = $("#ReceiverOfficeId").val();
                var ReceiverOffice = $("#ReceiverOfficeId option:selected").text()
                var ReceiverBankAccId = $("#ReceiverBankAccId").val();
                var ReceiverBankAccName = $("#ReceiverBankAccId option:selected").text()
                var FundAccID = $("#AccID").val();
                var FundAccCode = $("#txtAccCode").val();
                var officeID = $("#OfficeID").val();
                var rec_code = ReceiverOffice.split(" ")[0]
                htm = "", htm_body = "";
                var Narration = $("#Narration").val();
                var Reference = $("#Reference").val();

                var htm_header = `<thead class="tHead"><tr><th style="width: 5%; height:35px; vertical-align:middle; text-align:center;">Sl</th><th style="width: 20%; vertical-align:middle;">Account Code</th><th style="width: 40%; vertical-align:middle;">Description</th><th style="width: 15%; vertical-align:middle; text-align:right;">Debit</th><th style="width: 15%; vertical-align:middle; text-align:right;">Credit</th></tr></thead>`;
                var htm_foot = `<tfoot><tr class="tFoot"><td>&nbsp;</td><td>&nbsp;</td><td style="text-align:right;">Total Amount</td><td style="text-align:right;">${amt}</td><td style="text-align:right;">${amt}</td></tr></tfoot>`;

                // Sender
                var sender = [
                    { "Sl": 1, "OfficeID": officeID, "AccID": FundAccID, "Debit": amt, "Credit": 0 },
                    { "Sl": 2, "OfficeID": officeID, "AccID": SenderBankAccId, "Debit": 0, "Credit": amt }
                ];
                htm_body = `<tbody><tr><td style="text-align:center;">1</td><td>${FundAccCode}</td><td>${Narration}</td><td style="text-align:right;">${amt}</td><td style="text-align:right;">0</td></tr><tr><td style="text-align:center;">2</td><td>${SenderBankAccName}</td><td>${Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${amt}</td></tr></tbody>`
                htm += `<div style="font-weight: bold;font-size: 18px;">Sender Voucher Office:${officecode} - ${officeName}</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;
                // Receiver
                //---------------------- BR to HO

                if (rec_code == "99999") {
                    var data = GenerateAjaxRequist("/FundTransfer/GetFundXAccHead", { sendOffID: officeID, senderOffCode: officecode, revOfficeID: ReceiverOfficeId, receiverOfficeCode: rec_code, mappingAccid: FundAccID }, "GET");

                    if (data.status == 0) {
                        $("#loading").hide();
                        $("#dvMessage").attr('class', 'failed');
                        $("#dvMessage").html('Fund Transfer Account Mapping not found.');
                        $("#dvMessage").show();
                        jsonObj = {};
                        $("#dvInnerTable").html("");
                        return false;
                    }
                    else {
                        var receiver = [
                            { "Sl": 1, "OfficeID": ReceiverOfficeId, "AccID": ReceiverBankAccId, "Debit": amt, "Credit": 0 },
                            { "Sl": 2, "OfficeID": ReceiverOfficeId, "AccID": data.obj.AccID, "Debit": 0, "Credit": amt }
                        ]
                        var acc_name = data.obj.AccCode + " - " + data.obj.AccName;
                        htm_body = `<tbody><tr><td style="text-align:center;">1</td><td>${ReceiverBankAccName}</td><td>${Narration}</td><td style="text-align:right;">${amt}</td><td style="text-align:right;">0</td></tr><tr><td style="text-align:center;">2</td><td>${acc_name}</td><td>${Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${amt}</td></tr></tbody>`
                        htm += `<div style="font-weight: bold;font-size: 18px;">Receiver Voucher Office:${ReceiverOffice}</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;
                    }
                }
                //---------------------- BR to HO
                //---------------------- HO to BR
                else if (officecode == "99999") {
                    var data = GenerateAjaxRequist("/FundTransfer/GetFundXAccHead", { sendOffID: officeID, senderOffCode: officecode, revOfficeID: ReceiverOfficeId, receiverOfficeCode: rec_code, mappingAccid: FundAccID }, "GET");

                    if (data.status == 0) {
                        $("#loading").hide();
                        $("#dvMessage").attr('class', 'failed');
                        $("#dvMessage").html('Fund Transfer Account Mapping not found.');
                        $.alert.open('Error', 'Fund Transfer Account Mapping not found.');
                        $("#dvMessage").show();
                        jsonObj = {};
                        $("#dvInnerTable").html("");
                        return false;
                    }
                    else {
                        var receiver = [
                            { "Sl": 1, "OfficeID": ReceiverOfficeId, "AccID": ReceiverBankAccId, "Debit": amt, "Credit": 0 },
                            { "Sl": 2, "OfficeID": ReceiverOfficeId, "AccID": data.obj.AccID , "Debit": 0, "Credit": amt }
                        ]
                        var acc_name = data.obj.AccCode + " - " + data.obj.AccName;
                        htm_body = `<tbody><tr><td style="text-align:center;">1</td><td>${ReceiverBankAccName}</td><td>${Narration}</td><td style="text-align:right;">${amt}</td><td style="text-align:right;">0</td></tr><tr><td style="text-align:center;">2</td><td>${acc_name}</td><td>${Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${amt}</td></tr></tbody>`
                        htm += `<div style="font-weight: bold;font-size: 18px;">Receiver Voucher Office:${ReceiverOffice}</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;
                    }
                }
                //---------------------- HO to BR
                //---------------------- Branch to Branch
                else {
                    var receiver = [
                        { "Sl": 1, "OfficeID": ReceiverOfficeId, "AccID": ReceiverBankAccId, "Debit": amt, "Credit": 0 },
                        { "Sl": 2, "OfficeID": ReceiverOfficeId, "AccID": FundAccID, "Debit": 0, "Credit": amt }
                    ]

                    htm_body = `<tbody><tr><td style="text-align:center;">1</td><td>${ReceiverBankAccName}</td><td>${Narration}</td><td style="text-align:right;">${amt}</td><td style="text-align:right;">0</td></tr><tr><td style="text-align:center;">2</td><td>${FundAccCode}</td><td>${Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${amt}</td></tr></tbody>`
                    htm += `<div style="font-weight: bold;font-size: 18px;">Receiver Voucher Office:${ReceiverOffice}</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;
                }

                // HO
                var ho_voucer = []


                if (officecode != "99999" && rec_code != "99999") {
                    var r_off_code = ReceiverOffice.split(" ")[0];

                    var data = GenerateAjaxRequist("/FundTransfer/GetFundXAccHead", { sendOffID: officeID, senderOffCode: officecode, revOfficeID: ReceiverOfficeId, receiverOfficeCode: r_off_code, mappingAccid: FundAccID }, "GET");

                    if (data.status == 0) {
                        $("#loading").hide();
                        $("#dvMessage").attr('class', 'failed');
                        $("#dvMessage").html('Fund Transfer Account Mapping not found.');
                        $.alert.open('Error', 'Fund Transfer Account Mapping not found.');
                        $("#dvMessage").show();
                        jsonObj = {};
                        $("#dvInnerTable").html("");
                        return false;
                    }
                    else {
                        ho_voucer.push({ "Sl": 1, "OfficeID": data.ho_ID, "AccID": data.rev_obj.AccID, "Debit": amt, "Credit": 0 })
                        ho_voucer.push({ "Sl": 2, "OfficeID": data.ho_ID, "AccID": data.snd_obj.AccID, "Debit": 0, "Credit": amt })
                        var receiverAcc_name = data.rev_obj.AccCode + " - " + data.rev_obj.AccName;
                        var senderacc_name = data.snd_obj.AccCode + " - " + data.snd_obj.AccName;
                        htm_body = `<tbody><tr><td style="text-align:center;">1</td><td>${receiverAcc_name}</td><td>${Narration}</td><td style="text-align:right;">${amt}</td><td style="text-align:right;">0</td></tr><tr><td style="text-align:center;">2</td><td>${senderacc_name}</td><td>${Narration}</td><td style="text-align:right;">0</td><td style="text-align:right;">${amt}</td></tr></tbody>`
                        htm += `<div style="font-weight: bold;font-size: 18px;">Head Office Voucher</div><table cellpadding="5" cellspacing="0" width="100%">${htm_header}${htm_body}${htm_foot}</table>`;
                    }

                }
                jsonObj = { "TransactionType": $('#TransactionType').val(), "Date": $("#TrxDate").val(), "Narration": Narration, "Reference": Reference, "Sender": sender, "Receiver": receiver, "HO_vou": ho_voucer }

                $("#dvInnerTable").html(htm);

                $('#TransactionType,#SenderOfficeId,#Amount,#SenderBankAccId,#ReceiverOfficeId,#ReceiverBankAccId').prop("disabled", true);
                $('#btnCreate').prop("disabled", false)
                $('#btnAdd').prop("disabled", true)
                $("#loading").hide();
                $("#DivTableView").show();
            } else {
                $("#loading").hide();
                $("#dvMessage").attr('class', 'failed');
                $("#dvMessage").html('All Fields are required.');
                $.alert.open('Error', 'All Fields are required.');
                $("#dvMessage").show();
            }
            _br_accID = 0; _ho_accID = 0;
        }
        $("#btnCreate").click(function (e) {
            //Loader on Save
            $('#btnCreate').prop('disabled', true)
            $('#btnCreate').html("<i class='fa fa-spinner fa-pulse'></i> Saving...")

            $("#loading").show();
            e.preventDefault();
            if ($('#TransactionType').val() == "Jr")
                jsonObj = { "TransactionType": $('#TransactionType').val(), "Date": $("#TrxDate").val(), "Narration": Narration, "Reference": Reference, "Sender": jr_sender_json, "Receiver": jr_receiver_json};

            var data = GenerateAjaxRequist("/FundTransfer/PostFundTransferVoucher", JSON.stringify({ model: jsonObj }), "POST");
            if (data.status == 1) {
                $("#dvInnerTable").html("");
                $('#btnAdd').prop("disabled", false)
            }
            else
                $('#btnCreate').prop('disabled', false)

            $('#btnCreate').text("Save")
            $("#loading").hide();
            $("#dvMessage").attr('class', data.status == 1? 'success':'failed');
            $("#dvMessage").html(data.message);
            $.alert.open('Success', data.message);
            $("#dvMessage").show();


                $('#TransactionType,#SenderOfficeId,#Amount,#SenderBankAccId,#ReceiverOfficeId,#ReceiverBankAccId,#btnAdd').prop("disabled", false);
                $('#btnCreate').prop("disabled", true);
                $("#Amount,#AccID,#txtAccCode,#Narration,#Reference,select").val("");
                //$("input,select").not(':input[type=button], :input[type=submit], :input[type=reset]').val("");
                $("#dvInnerTable").html("");
                $("#DivTableView").hide();


        });
    });
</script>
