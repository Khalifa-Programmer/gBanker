            if (tranType == "Jr") {
                var data = GenerateAjaxRequist("/FundTransfer/LoadOffice", { v_type: tranType }, "GET");

                var htm = "";
                $.each(data, function (index, value) {
                    htm += `<option value="${value.Value}">${value.Text}</option>`
                });
                $("#ddlReceiverOfficeId").html(htm)
                $("#dvJr").show();
                $("#dvSendBank,#dvReceiveBank,#dvNotJr").hide();
            } else {
                LoadBank(tranType, officeid, 'SenderBankAccId');
                $("#ReceiverOfficeId").trigger("change");
                $("#dvSendBank,#dvReceiveBank,#dvNotJr").show();
                $("#dvJr").hide();

            }

        });

        $("#ReceiverOfficeId").change(function (e) {

            if (e.target.value) {
                LoadBank($('#TransactionType').val(), e.target.value, 'ReceiverBankAccId');
            }
            else $(`#ReceiverBankAccId`).html(`<option value="0">Please Select</option>`);
        });
        $('#btnCreate').prop('disabled', true);

        var MyReffNo = $("#ReffNo option:selected").val();
        if (MyReffNo == "") {
            $("#VoucherType option[value='Dr']").prop('selected', 'selected');
        }
        else {
            $("#VoucherType option[value='Cr']").prop('selected', 'selected');
        }
        $("#VoucherType").prop("disabled", true);

        $("#loading").hide();
        $("#DivTableView").hide();
        CheckVoucherType();
        $("#VoucherNo").prop("readonly", true);
        $("#VoucherType").change(function () {
            CheckVoucherType();
        });


        $('#IsReconcile').change(function () {
            ShowReconcile();
        })
        $("#ReffNo").change(function (e) {
            e.preventDefault();
            SenderOrReceiveReconcile();
            ReffNoWiseOffice();
