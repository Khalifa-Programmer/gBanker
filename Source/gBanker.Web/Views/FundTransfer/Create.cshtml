        $("#txtAccCode").autocomplete({

            source: function (request, response) {
                if (request.term.length > 2) {
                    var IsReconcile = $("#IsReconcile").is(":checked") ? true : false;
                    $.ajax({
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("GetHOFundAccCode", "FundTransfer", "http")',
                        type: "GET",
                        dataType: 'json',
                        async: true,
                        data: { acc_code: request.term, OfficeLevel: $("#OfficeLevel").val(), TransactionType: $("#TransactionType").val(), IsReconcile: true },
                        minLength: 1,
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.AccID,
                                    label: item.AccFullName
                                };
                            }))
                        }
                    })
                }
            },
            messages: {
                noResults: "", results: ""
            },
            focus: function (event, ui) {
                $("#txtAccCode").val(ui.item.label);
                return false;
            },
            select: function (event, ui) {
                $("#txtAccCode").val(ui.item.label);
                $("#AccID").val(ui.item.value);
                return false;
            },
            change: function (event, ui) {
                if (ui.item) {
                    $("#txtAccCode").val(ui.item.label);
                    $("#AccID").val(ui.item.value);
                }
                return false;
            }
        });


        $('#btnClear').click(function (e) {
            e.preventDefault();
            $('#TransactionType,#SenderOfficeId,#Amount,#SenderBankAccId,#ReceiverOfficeId,#ReceiverBankAccId,#btnAdd').prop("disabled", false);
            $('#btnCreate').prop("disabled", true);
            $("#Amount,#AccID,#txtAccCode,#Narration,#Reference,select").val("");
            //$("input,select").not(':input[type=button], :input[type=submit], :input[type=reset]').val("");
            $("#dvInnerTable").html("");
            $("#DivTableView").hide();
        });
        $('#btnAdd').click(function (e) {
            e.preventDefault();
            $("#loading").show();
           
            if ($('#TransactionType').val() == "Ba") {
