    function Edit(MembersLoanBalanceID) {
        console.log(MembersLoanBalanceID);

         $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDataForMembersLoanBalance", "LoanApproval")',
            type: "GET",
            dataType: 'json',
            async: true,
             data: { MembersLoanBalanceID : MembersLoanBalanceID },

            success: function (result) {
                $("#OfficeID").val(result.OfficeID);
                $("#MemberID").val(result.MemberID);
                $("#CenterID").val(result.CenterID);
                $("#MemberCategoryID").val(result.MembersCategoryID);
                $("#GS").val(result.GeneralSavings);
                $("#VS").val(result.VoluntarySavings);
                $("#LTS").val(result.LTS);
                $("#LoanBalance").val(result.LoanBalance);
                $("#SCBalance").val(result.SCbalance);
                $("#PassBookEntryDate").val(result.PassBookEntryDate);
                $("#LoanBalanceID").val(result.MembersLoanBalanceID);
                $("#memberAutoComplete").val(result.MembersInfo);
            },
            error: function (error) {
                //alert('error');
            }
        });



    }

    function ClearForm() {
       // $("#OfficeID").val('0');
        $("#MemberID").val('0');
        $("#CenterID").val('0');
        $("#MemberCategoryID").val('0');
        $("#GS").val('0');
        $("#VS").val('0');
        $("#LTS").val('0');
        $("#LoanBalance").val('0');
        $("#SCBalance").val('0');
        $("#LoanBalanceID").val('0');
        $("#memberAutoComplete").val('');
    }

    function Delete(MembersLoanBalanceID) {
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {
                console.log(MembersLoanBalanceID);

                $.ajax({
                        type: 'POST',
                        contentType: "application/json; charset=utf-8",
                        url: '/LoanApproval/DeleteForMembersLoanBalance?MembersLoanBalanceID=' + MembersLoanBalanceID,
                        dataType: 'json',
                        async: false,
                        success: function (data) {//klm
                            if (data.result==1) {
                                $.alert.open("Success", data.message);
                                reloadGrid();
                            } else {
                                $.alert.open("Error", data.message);
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });

                reloadGrid();
            }
        });
    }



