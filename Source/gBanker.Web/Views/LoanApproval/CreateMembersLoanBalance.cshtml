                schema: {
                    data: "data",
                    total: "total"
                },
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                transport: {
                    read: {
                        url: '@Url.Action("GetListForMembersLoanBalanceFilterBy", "LoanApproval", "http")',
