
@{
    ViewBag.Title = "Manage Bank Information";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<h2>Manage Bank Information</h2>

<script type="text/javascript">

     //Save
    function SaveUpdateBankInfo() {

        //var BankInfoID = $("#hdnBankInfoID").val();
        //var AccId = $("#AccId").val();
        //var BankName = $("#BankName").val();
        //var AccountNumber = $("#AccountNumber").val();
        //var Address = $("#Address").val();


        var BankInfo = {
            BankInfoID : $("#hdnBankInfoID").val() ,
            AccID: $("#hdnAccID").val() ,
            BankName: $("#txtBankName").val() ,
            AccountNumber: $("#txtAccountNumber").val() ,
            BankAddress: $("#txtBankAddress").val()

        };


        $.ajax({
            type: 'GET',
            //contentType: "application/json; charset=utf-8",
            url: '@Url.Action("CreateUpdateBankInfo", "BankInformation", "http")', //CreateWorkArea(string WorkAreaName)
            data:  BankInfo ,
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", data);

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
                clear();
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Saved");

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }

        });

    }// End of Function


    function LoanAccCodeDropdown() {
        var ddlComponentD = $("#AccCode");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetAccCode", "BankInformation", "http")', // Load Loan category
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlComponentD.html('');
                $.each(data, function (id, option) {
                    ddlComponentD.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                $.alert.open(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function Edit(BankInfoID, AccID, BankName, AccountNumber, BankAddress ) {

        $("#AccCode option[value='" + AccID + "']").prop('selected', 'selected');

        $("#hdnBankInfoID").val(BankInfoID);
        $("#txtBankName").val(BankName);
        $("#txtAccountNumber").val(AccountNumber);
        $("#txtBankAddress").val(BankAddress);
        $("#hdnAccID").val(AccID)

        document.getElementById("btnSave").innerHTML = "Update" ;

        //BankInfoID: $("#hdnBankInfoID").val(),
        //    AccID: $("#hdnAccID").val(),
        //        BankName: $("#txtBankName").val(),
        //            AccountNumber: $("#txtAccountNumber").val(),
        //                BankAddress: $("#txtBankAddress").val()


    }

    function Validate() {

        var returnmsg = true;
        let BankInfoID = $("#hdnBankInfoID").val();
        let AccID = $("#hdnAccID").val();
        let BankName = $("#txtBankName").val();
        let AccountNumber = $("#txtAccountNumber").val();
        let BankAddress = $("#txtBankAddress").val();

        if (AccID == '0') {
            $.alert.open("Message", "Please Select Acc Code");
            returnmsg =  false;
        }
        else if (BankName == '') {
            $.alert.open("Message", "Please Select bank name");
            returnmsg = false;
        }
        else if (AccountNumber == '') {
            $.alert.open("Message", "Please Select Account Name");
            returnmsg =  false;
        }

        return returnmsg;

    }

    function Delete(id) {

        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                Delete2(id);
                return true;
            }
            else {

                return false;
            }
        });
    }


    function Delete2(id) {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("CreateUpdateBankInfo", "BankInformation", "http")',
            data: { BankInfoID: id },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", data);
                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });

            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Deleted.");
            }

        });

    }// End of Function


    function clear() {

        document.getElementById("btnSave").innerHTML = "Save";
        $("#AccCode").prop('selectedIndex', 0);
        $("#hdnBankInfoID").val('0');
        $("#txtBankName").val('');
        $("#txtAccountNumber").val('');
        $("#txtBankAddress").val('');
        $("#hdnAccID").val('0');

    }


    $(document).ready(function () {

        LoanAccCodeDropdown();
        $("#AccCode").change(function () {
            if ($("#AccCode option:selected").val() != "0") {
                $("#hdnAccID").val($("#AccCode option:selected").val());

                //$("#hdnAccID").val($("#AccCode option:selected").val().split("-")[0]);
               // $("#txtBankCode").val($("#AccCode option:selected").val().split("-")[1]);
            }

        });


        $("#btnSave").click(function () {
            if (Validate()) {
                SaveUpdateBankInfo();
            }


        });// END Button

        $("#btnReset").click(function () {
            clear();

        });// END Button


        $('#grid2').jtable({
            // title: 'Investor List',
            paging: true,
            pageSize: 5,
            sorting: false,
            defaultSorting: 'Name ASC',
            actions: {
                listAction: '/BankInformation/GetBankInfoList'
            },
            fields: {
                rowSl: {
                    title: 'SI No',
                    width: '10%'
                },
                BankInfoID: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                BankName: {
                    title: 'Bank Name',
                    width: '20%'
                },
                AccountNumber: {
                    title: 'Account Number',
                    width: '20%'
                },
                BankAddress: {
                    title: 'Bank Address',
                    width: '20%'
                },
                AccCode: {
                    title: 'Acc Code',
                    width: '20%'
                },
                BankCode: {
                    title: 'Bank Code',
                    width: '20%'
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Edit(' + data.record.BankInfoID + ',' + data.record.AccID + ',' + "'" + data.record.BankName + "'" + ',' + "'" + data.record.AccountNumber + "'" +',' + "'" +  data.record.BankAddress + "'" +')"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                DeleteLink: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Delete(' + data.record.BankInfoID + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }
                }
            }
        });
      reloadGrid2();
        //$('#grid').jtable('load');
        $("#filterColumn").change(function () {
            if ($(this).val() === "ViewAll") {
                $("#filterValue").val('');
            }
        });

        function reloadGrid2() {
            //$("#loading").show();
            $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            //$("#loading").hide();
        }




    }); // END Document Ready




</script>



@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container-fluid">
            <input type="hidden" id="hdnBankInfoID" value="0" />
            <input type="hidden" id="hdnAccID" value="0" />

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4 required"> Acc Code </label>
                        <div class="col-sm-8">
                            @Html.DropDownList("ComponentList", null, new { @ID = "AccCode", @class = "form-control" })

                        </div>
                    </div>
                </div>
                @*<div class="col-sm-6">
                        <div class="form-group">
                            <label class="control-label col-md-4 required"> Bank Code </label>
                            <div class="col-sm-8">
                                <input type="text" id="txtBankCode" class="form-control" readonly="readonly" />
                            </div>
                        </div>
                    </div>*@
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4 required"> Bank Name </label>
                        <div class="col-sm-8">
                            <input type="text" id="txtBankName" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4 required"> Account Number </label>
                        <div class="col-sm-8">
                            <input type="text" id="txtAccountNumber" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="control-label col-md-2">  Address </label>
                        <div class="col-sm-8">
                            <textarea rows="4" id="txtBankAddress" class="form-control" cols="50"> </textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <button type="button" id="btnSave" class="btn btn-primary"> Save </button>
                    &nbsp;
                    <button type="button" id="btnReset" class="btn btn-primary"> Reset </button>
                </div>
                &nbsp;

                <div class="col-md-12">
                    <div id="grid2"> </div>
                </div>

            </div>
        </div>
    </div>
}




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/searchable")

}