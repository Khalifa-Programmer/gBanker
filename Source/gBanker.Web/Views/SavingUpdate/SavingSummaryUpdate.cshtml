    function loadProductDropdown(dropdownid, selectedValue) {
        // $("#loading").show();
        $.ajax({
            type: "POST",
            url: '/SavingUpdate/GetProductListProcedure',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (data) {

                $("#" + dropdownid).append($("<option/>").val('0').text('Select Product'));
                $.each(data, function (id, option) {
                    console.log(selectedValue, option.Value)
                    if (selectedValue == option.Value) {
                        //alert(selectedValue);
                        $("#" + dropdownid).append($('<option></option>').val(option.Value).html(option.Text).attr('selected', 'selected'));
                    }
                    else {
                        $("#" + dropdownid).append($('<option></option>').val(option.Value).html(option.Text));
                    }


                });

                $("#loading").hide();
            },
            failure: function () {
                alert("Failed!");
            }
        });

    }

