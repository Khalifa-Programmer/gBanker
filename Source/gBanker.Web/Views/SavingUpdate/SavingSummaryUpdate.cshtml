<script type="text/javascript">

    // User can input only numbers
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }

    // Get Center DropdownList with the help of this function
    function GetCenter() {
        var ddlCenter = $("#ddlCenter");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '/SavingUpdate/GetCenterList',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlCenter.html('');
                $.each(data, function (id, option) {
                    ddlCenter.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    // Get Product List BY Member wise
    function GetProduct() {
        var ddlProd = $("#ddlProd");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '/SavingUpdate/GetProductListByMemberWithProcedure',
            data: { Qtype: 1, MemberID: $("#hdnMemberID").val(), ProductID: 0 },
            dataType: 'json',
            async: true,
            success: function (List_MemberwiseProduct) {
                console.log(List_MemberwiseProduct);
                ddlProd.html('');
                $.each(List_MemberwiseProduct, function (id, option) {
                    ddlProd.append($('<option></option>').val(option.ProductID).html(option.ProductName));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    // Get No Of Account List by Product & Member Wise
    function GetNoOfAccount() {
        var ddlNoOfAcc = $("#ddlNoOfAcc");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '/SavingUpdate/GetNoOfAccountWithMemberAndProduct',
            //data: { Member_id: Member_id, center_id: center_id },
            data: { MemberID: $("#hdnMemberID").val(), ProductID: $("#ddlProd").val() },
            dataType: 'json',
            async: true,
            success: function (data) {
                console.log(data);
                ddlNoOfAcc.html('');
                $.each(data, function (id, option) {
                    ddlNoOfAcc.append($('<option></option>').val(option.NoOfAccountValue).html(option.NoOfAccountText));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    //Go to next Row of GRID View Data
    function goNextRow(e, rowSl, id) {
        //up arrow 38
        if (e.keyCode == 38) {
            var newId = '#' + 'PrimaryKeyId' + (rowSl - 1).toString();
            var newIdVal = $(newId).val();
            var newFocusId = id + newIdVal.toString();
            $('#' + newFocusId).focus();
            $('#' + newFocusId).select();
        }
        else if (e.keyCode == 40) {
            var newId = '#' + 'PrimaryKeyId' + (rowSl + 1).toString();
            var newIdVal = $(newId).val();
            var newFocusId = id + newIdVal.toString();
            $('#' + newFocusId).focus();
            $('#' + newFocusId).select();
        }
    }

    function SaveAndReload() {
        var allCollection = new Array();

        var $modifiedRow = $('.jtable-row-changed');
        var allInputsInModifiedRow = $modifiedRow.find('input[type="text"]');

        console.log(allInputsInModifiedRow);

        allInputsInModifiedRow.each(function () {
            var value = $(this).val();
            var id = $(this).attr('id');

            var obj = new Object();

            obj.Key = id;
            obj.Value = value;

            allCollection[allCollection.length] = obj;
        });


        var $allId = $('input[type="hidden"]');
        var allIds = new Array();

        $allId.each(function () {
            var value = $(this).val();
            allIds[allIds.length] = value;
        });

        var allTrx = new Object();
        allTrx.allTrx = allCollection;
        allTrx.allSavingTrxId = allIds;
        /*
        Additional info while Insert Data
        */
        allTrx.center      = $("#ddlCenter option:selected").val();
        allTrx.member      = $("#hdnMemberID").val();
        allTrx.product     = $("#ddlProd option:selected").val();
        allTrx.noOfAccount = $("#ddlNoOfAcc option:selected").val();
        /*END */

        var json = JSON.stringify(allTrx);

        //$("#loading").show();
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SaveSavingummaryUpdate", "SavingUpdate", "http")',
            type: "POST",
            dataType: 'json',
            async: true,
            data: json,

            success: function (resp) {
                $("#loading").hide();
                var result = resp.Result;
                var msg = resp.Message;
                var css = "failed";
                if (result == "OK")
                    css = "success";
                $("#dvMessage").attr('class', css);
                $("#dvMessage").html(msg);
                $("#dvMessage").show();


                $("#dvMessageDown").attr('class', css);
                $("#dvMessageDown").html(msg);
                $("#dvMessageDown").show();

                if (result == "OK") {
                    $("#dvMessage").toggle('fade', 1500);
                    $("#dvMessageDown").toggle('fade', 1500);
                    setTimeout("hideMsg()", 1500);
                }
            },
            error: function (err) {
                $("#loading").hide();
                var msg = err.responseText;
                var css = "failed";
                $("#dvMessage").attr('class', css);
                $("#dvMessage").html(msg);
                $("#dvMessage").show();

                $("#dvMessageDown").attr('class', css);
                $("#dvMessageDown").html(msg);
                $("#dvMessageDown").show();
            }
        });
    }// ENd Save Grid Function


