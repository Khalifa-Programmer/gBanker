            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Select Center", new { @class = "control-label" })
                    @Html.DropDownList("CenterList", null, new { @ID = "ddlCenter", @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Member", htmlAttributes: new { @class = "control-label" })

                    @Html.TextBox("memberAutoComplete", "", new { @class = "form-control" })
                    <input type="hidden" id="hdnMemberID" value="0" />

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Select Product", new { @class = "control-label" })
                    @Html.DropDownList("ProductListByMember", null, new { @ID = "ddlProd", @class = "form-control" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("No Of Account", new { @class = "control-label" })
                    @Html.DropDownList("NoOAccList", null, new { @ID = "ddlNoOfAcc", @class = "form-control" })
                </div>
            </div>
        </div>
    </div>

    //Button to SHow Data into grid according to dropdown Selected
    <h2 class="page-title"></h2>
    <div class="">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group from-action">
                    <input type="submit" value="View" class="btn btn-primary" id="btnView" />
                </div>
            </div>
        </div>

        @*GRID View*@
        <div class="row">
            <div id="grid"></div>
        </div>


        @*//Button to Save the data*@
        <div class="row" id="dvgridButton">
            <div class="col-md-12">
                <div class="form-group from-action">

                    <input type="button" value="Save" class="btn btn-primary" onclick="SaveAndReload();" />

                    @*&nbsp;&nbsp; <input type="button" value="Add New" class="btn btn-primary" id="btnAddNew" />*@
                </div>
            </div>
        </div>
    </div>

}



<!-- Popup Member Select -->
<div id="MemberDiv" title="Member Select" style="display:none">
    @*khalid*@
    <div class="ui-widget">
        <div class="col-sm-12">
            <div class="form-group">
                @Html.Label("Member", htmlAttributes: new { @class = "control-label" })

                @Html.TextBox("memberAutoCompleteSelect", "", new { @class = "form-control" })
                <input type="hidden" id="currentSummaryId" value="0" />
                <input type="hidden" id="hdnCurrentSummaryId" value="0" />
            </div>
        </div>
    </div>

</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}
