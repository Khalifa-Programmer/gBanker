    function formatDate(date) {
        const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const day = date.getDate().toString().padStart(2, "0");
        const month = months[date.getMonth()];
        const year = date.getFullYear().toString();
        return `${day}-${month}-${year}`;
    }

    function Edit(AccID, PrincipalAmount, LoanSanctionNo, LoanSanctionTerm, LoanSanctionApproveDate,
        LoanDisbursementDate, DisbursedAmount, InterestRate, LoanDuration, GracePeriod, TotalInstallmentNo) {
        let lsad = String(LoanSanctionApproveDate);
        let lsadUnixDate = lsad.slice(6, 19);
        let lsadToInt = parseInt(lsadUnixDate);
        let loanSancAprvDate = new Date(lsadToInt)
        let formattedLoanSancAppvDate = formatDate(loanSancAprvDate);
        console.log(formattedLoanSancAppvDate);

        let ldd = String(LoanDisbursementDate);
        let lddUnixDate = ldd.slice(6, 19);
        let lddToInt = parseInt(lddUnixDate);
        let loanDisbDate = new Date(lddToInt);
        let formattedLoanDisbDate = formatDate(loanDisbDate);
        console.log(formattedLoanDisbDate);

        $("#FundLoanCode").val(AccID);
        $("#PrincipalAmount").val(PrincipalAmount);
        $("#LoanSanctionNo").val(LoanSanctionNo);
        $("#LoanSanctionTerm").val(LoanSanctionTerm);
        $("#LoanSanctionApproveDate").val(formattedLoanSancAppvDate);
        $("#LoanDisbursementDate").val(formattedLoanDisbDate);
        $("#DisbursedAmount").val(DisbursedAmount);
        $("#InterestRate").val(InterestRate);
        $("#LoanDuration").val(LoanDuration);
        $("#GracePeriod").val(GracePeriod);
        $("#TotalInstallmentNo").val(TotalInstallmentNo);

    }
    //Delete
    function Delete(loanCode, loanSanctionNo, loanSanctionTerm, loanDisbursementDate) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                DeleteFundLoanDetails(loanCode, loanSanctionNo, loanSanctionTerm, loanDisbursementDate);
                $('#grid1').jtable('load', { DateFromValue: $('#DateFromValue').val(), DateToValue: $('#DateToValue').val() });
                return true;
            }
            else {
                return false;
            }
        });
    }

    function DeleteFundLoanDetails(loanCode, loanSanctionNo, loanSanctionTerm, loanDisbursementDate) {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '/FundManagement/DeleteFundLoanDetails',
            data: { LoanCode: loanCode, LoanSanctionNo: loanSanctionNo, LoanSanctionTerm: loanSanctionTerm, LoanDisbursementDate: loanDisbursementDate },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Delete Successfully");
                //$('#grid1').jtable('load', { DateFromValue: $('#DateFromValue').val(), DateToValue: $('#DateToValue').val() });
            },
            error: function () {
                $.alert.open("Message", "Error Occured to Delete!");
            }
        });
    }

