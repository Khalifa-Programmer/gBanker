        background-color: yellow;
    }

    .hidemsg {
        display: none;
    }
    /*.input{
           font-size:40px;
       }*/
</style>
<script type="text/javascript">

    function displayLoanSummaryReport()
    {

        var startDate = $("#startDate").val();
        var endDate = $("#endDate").val();
        var reportParam = startDate + ',' + endDate;
        var url = '/Report/Print?reportId=LoanSummary&reportparams=' + reportParam;
        window.open(url, "_blank");
    }

    function displayProductReport() {

        var processtDate = $("#ProcessDate").val();
        var endDate = $("#endDate").val();
        var reportParam = startDate + ',' + endDate;
        var url = '/Report/Print?reportId=Product&reportparams=' + reportParam;
        window.open(url, "_blank");
    }
    function monthlyProcess() {
        // e.preventDefault();
        var officeId = 1;
        var DateFrom = $("#txtFromDt").val();
        var DateTo = $("#txtToDt").val();
        var businessDate = $("#ProcessDate").val();

        $("#loading").show();

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GenerateMRAMonthlyInformation", "GroupwiseReport", "http")',
            data: { officeId: officeId, DateFrom: DateFrom, DateTo: DateTo },
            dataType: 'json',
            async: true,
            success: function (data) {


                $("#loading").hide();
                var msg = "Monthly Process Completed Successfully.";
                var css = "success";
                if (data.Message != null) {
                    msg = data.Message;
                    css = "failed"
                }
                $("#dvMessage").attr('class', css);
                $("#dvMessage").html(msg);
                $("#dvMessage").show();
                if (data.Message == null)
                    $("#dvMessage").toggle('fade', 1500);

            },
            error: function (request, status, error) {
                $("#loading").hide();
                $("#dvMessage").attr('class', 'failed');
                $("#dvMessage").html(request.statusText);
                $("#dvMessage").show();
            }
        });
    }
    $(document).ready(function () {


         $("#txtFromDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });
        $("#txtToDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });

        //confirmDayInitiated();
        $("#confirmDlg").dialog({
            autoOpen: false,
            height: 150,
            width: 400,
            modal: true,
            title: 'Confirmation',
            buttons: {
                "Yes": function () {
                    monthlyProcess();
                    $(this).dialog("close");
                },
                "No": function () {
                    //alert("No Office selected. Employee office will be used.");
                    $(this).dialog("close");
                }
            }
        });

        $('#BusinessDate').bind('focus', function (e) {
            $("#dvMessage").hide();
        });
        $("#OfficeId").change(function () {
            var officeId = $("#OfficeId").val();
        });

        $("#btnView").click(function (e) {
            e.preventDefault();
          var DateFrom = $("#txtFromDt").val();
            var DateTo = $("#txtToDt").val();
           var officeId = 1;
            var url;
            if (DateFrom != '' && DateTo != '') {
                var url = '/GroupwiseReport/GenerateMRAMonthlyInformationView?Qtype=1&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&officeId=' + officeId;
               window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
           else {
                alert('Date field cannot be blank')
           }
        });

        $('#btnProcess').click(function (e) {
            e.preventDefault();
            $("#confirmDlg").dialog('open');
        });

    });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        //  $("#BusinessDate").datepicker();
        gBankerDatePicker("ProcessDate");
    });


</script>
<h2 class="page-title"> MRA Monthly Process</h2>


<div id="confirmDlg" style="display:none">
    <div class="form-group">
        Do you want to run the Monthly Process?
    </div>

</div>

<div>
    <br />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Date From", new { @class = "control-label" })
                    @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtFromDt", @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Date To", new { @class = "control-label" })
                    @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtToDt", @class = "form-control" })
                </div>
            </div>
        </div>
        <h2 class="page-title"></h2>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group from-action">
                    @*<input type="submit" value="View" class="btn btn-primary" id="btnView" />*@
                    <input id="btnProcess" type="submit" value="Process" class="btn btn-primary"  />
                    <input id="btnView" type="button" value="View" class="btn btn-primary" />
                </div>
            </div>
        </div>
    }

</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/gbUtility")

}
