@model gBanker.Web.ViewModels.OfficeViewModel



@{
    ViewBag.Title = "StaffWise Consolidation Process";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var offices = Model == null ? null : Model.OfficeList;
}

<script>
    $(document).ready(function () {

        $('.ddl-select-picker').selectpicker();

        $("#FromDate").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });

        $("#ToDate").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });

        $('#btnProcess').click(function () {

            $(this).prop("disabled", true);
            $(this).html("<i class='fa fa-spinner fa-pulse'></i> Processing...");

            var officeid = $("#OfficeID").val();
            var fromDate = $("#FromDate").val();
            var toDate = $("#ToDate").val();

            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '/GroupwiseReport/GenerateStaffWiseConsolidation',
                data: { OfficeIds: JSON.stringify(officeid), FromDate: fromDate, ToDate: toDate },
                dataType: 'json',
                async: true,
                success: function (data) {
                    $.alert.open(data.Msg);
                    $('#btnProcess').prop("disabled", false);
                    $('#btnProcess').text("Process");
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                    $('#btnProcess').prop("disabled", false);
                    $('#btnProcess').text("Process");
                }
            });
        });
    });
</script>

<h2 class="page-title">StaffWise Consolidation Process</h2>

<div class="">
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.LabelFor(model => model.OfficeID, htmlAttributes: new { @class = "control-label" })
                @Html.DropDownListFor(model => model.OfficeID, offices, new { @multiple = "multiple", @class = "ddl-select-picker form-control", data_live_search = "true" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date From", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "FromDate", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date To", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "ToDate", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <button class="btn btn-primary" id="btnProcess">Process</button>
        </div>
    </div>

</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/searchable")

    <link href="~/Assets/js/plugins/boostrap-selelect/bootstrap-select.min.css" rel="stylesheet" />
    <script src="~/Assets/js/plugins/boostrap-selelect/bootstrap-select.min.js"></script>
}


