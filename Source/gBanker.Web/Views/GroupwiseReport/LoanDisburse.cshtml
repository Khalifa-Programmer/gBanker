
@{
    ViewBag.Title = "LoanDisburse";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}


<script type="text/javascript">
    function GetCenter() {
        var ddlCenter = $("#ddlCenter");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCenterList", "GroupwiseReport", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlCenter.html('');
                $.each(data, function (id, option) {
                    ddlCenter.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetMember() {
        var ddlMember = $("#ddlMember");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMemberList", "GroupwiseReport", "http")',
            data: { centerId: $("#ddlCenter option:selected").val() },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlMember.html('');
                $.each(data, function (id, option) {
                    ddlMember.append($('<option></option>').val(option.MemberID).html(option.MemberName));


                //$.each(data, function (id, option) {
                //    ddlMember.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    //Main Product List

    function GetMainProduct() {

        var ddlProduct = $("#ddlMainProduct");
        $('#AjaxLoader').show();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMainProductList", "GroupwiseReport", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                $('#AjaxLoader').hide();
                ddlProduct.html('');
                $.each(data, function (id, option) {
                    ddlProduct.append($('<option></option>').val(option.MainProductCode).html(option.MainItemName));
                   
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    $(document).ready(function () {
        GetCenter();

        GetMainProduct();
        //GetMember();

        $("#ddlCenter").change(function () {
            var ddlCenter = $("#ddlCenter option:selected").val();
            if (ddlCenter > 0) {
                GetMember();
            }
            else {
                GetMember();
            }
        });

        $("#txtFromDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });
        $("#txtToDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });

        $("#btnView").click(function (e) {
            e.preventDefault();
            var DateFrom = $("#txtFromDt").val();
            var DateTo = $("#txtToDt").val();
            var url;
            var center = $("#ddlCenter").val();
            var member = $("#ddlMember").val();

            var productCode = $("#ddlMainProduct").val();

            if (DateFrom != '' && DateTo != '') {
                if (center > 0 && member > 0)  {
                    url = '/GroupwiseReport/GenerateLoanDisburse?Qtype=3&Center=' + center + '&Member=' + member + '&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
            }
                else if (center > 0 && member==0) {
                    url = '/GroupwiseReport/GenerateLoanDisburse?Qtype=2&Center=' + center + '&Member=0&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
            }
                else if (center == 0 && member == 0) {
                    url = '/GroupwiseReport/GenerateLoanDisburse?Qtype=1&Center=0&Member=0&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
                }

                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
            else {
                alert('Date field cannot be blank')
            }
        });


        // Execl Report

        $('#btnExport').click(function () {
            //e.preventDefault();
            var url;
            var DateFrom = $("#txtFromDt").val();
            var DateTo = $("#txtToDt").val();
            var url;
            var center = $("#ddlCenter").val();
            var member = $("#ddlMember").val();

            var productCode = $("#ddlMainProduct").val();

            if (DateFrom != '' && DateTo != '') {
                if (center > 0 && member > 0) {
                   // url = '/GroupwiseReport/GenerateLoanDisburse?Qtype=3&Center=' + center + '&Member=' + member + '&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
                    window.location = '/GroupwiseReport/LoanDisburseExeclReport?Qtype=3&Center=' + center + '&Member=' + member + '&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
                }
                else if (center > 0 && member == 0) {
                    window.location = '/GroupwiseReport/LoanDisburseExeclReport?Qtype=2&Center=' + center + '&Member=0&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
                }
                else if (center == 0 && member == 0) {
                    window.location = '/GroupwiseReport/LoanDisburseExeclReport?Qtype=1&Center=0&Member=0&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&MainProductCode=' + productCode;
                }

               // window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
            else {
                alert('Date field cannot be blank')
            }

            //if (center > 0) {
            //    window.location = '/GroupwiseReport/LoanDisburseExeclReport?Qtype=2&Center=' + center;
            //    //url = '/GroupwiseReport/GenerateDailyLoanCollectionNewReport?Qtype=2&Center=' + center;
            //}
            //else if (center == 0) {
            //    window.location = '/GroupwiseReport/LoanDisburseExeclReport?Qtype=1&Center=0';
            //    //url = '/GroupwiseReport/GenerateDailyLoanCollectionNewReport?Qtype=1&Center=0';
            //}
            //window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
        });




    });
</script>
<h2 class="page-title">Loan Disburse</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Select Center", new { @class = "control-label" })
                @Html.DropDownList("CenterList", null, new { @ID = "ddlCenter", @class = "form-control" })
            </div>
        </div>
        <div class="col-md-8">&nbsp;</div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Member", htmlAttributes: new { @class = "control-label" })
                @Html.DropDownList("MemberList", null, new { @ID = "ddlMember", @class = "form-control" })
                @*@Html.TextBox("memberAutoComplete", "", new { @class = "form-control" })*@
            </div>
        </div>
        <div class="col-md-8">&nbsp;</div>
    </div>


    // ProductList
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Product", htmlAttributes: new { @class = "control-label" })
                @Html.DropDownList("ProductList", null, new { @ID = "ddlMainProduct", @class = "form-control" })
                @*@Html.TextBox(" ", "", new { @ID = "txtToDt", @class = "form-control" })*@
            </div>
        </div>
        <div class="col-md-8">&nbsp;</div>
    </div>


    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date From", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtFromDt", @class = "form-control" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date To", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtToDt", @class = "form-control" })
            </div>
        </div>
    </div>
    <h2 class="page-title"></h2>
    <div class="row">
        <div class="col-md-2">
            <div class="form-group from-action">
                <input type="submit" value="View" class="btn btn-primary" id="btnView" />
            </div>
        </div>

        <div class="col-md-10">
            <div class="form-group from-action">
                <input type="button" id="btnExport" value="Export" class="btn btn-primary" />
            </div>
        </div>


    </div>

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}

