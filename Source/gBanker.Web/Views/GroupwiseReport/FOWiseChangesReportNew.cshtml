
@{
    ViewBag.Title = "FOWise ChangesReport";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<script type="text/javascript">


    function GetZoneOffice() {
        var HO_val = $("#ddlHO").val();
        if (HO_val > 0) {
            var ddlZone = $("#ddlZone");
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetZoneList", "GroupwiseReport", "http")',
                data: { HO_val: HO_val },
                dataType: 'json',
                async: true,
                success: function (data) {
                    ddlZone.html('');
                    ddlZone.append($('<option></option>').val("0").html("Please Select"));
                    $.each(data, function (id, option) {
                        ddlZone.append($('<option></option>').val(option.Value).html(option.Text));
                    });
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
        else {
            $("#ddlZone").empty();
            $("#ddlArea").empty();
            $("#ddlOffice").empty();
        }
    }

    function GetHO() {
        var ddlHO = $("#ddlHO");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetHOList", "GroupwiseReport", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlHO.html('');
                $.each(data, function (id, option) {
                    ddlHO.append($('<option></option>').val(option.Value).html(option.Text));
                });
                GetZoneOffice();
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    $(document).ready(function () {
        GetHO();
        $("#ddlZone").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            if (HO_val > 0 && zone_val > 0) {
                var ddlArea = $("#ddlArea");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetAreaList", "GroupwiseReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlArea.html('');
                        ddlArea.append($('<option></option>').val("0").html("Please Select"));
                        $.each(data, function (id, option) {
                            ddlArea.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        $("#ddlOffice").empty();
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlArea").empty();
                $("#ddlOffice").empty();
            }
        });
        $("#ddlArea").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            var area_val = $("#ddlArea").val();
            if (HO_val > 0 && zone_val > 0 && area_val > 0) {
                var ddlOffice = $("#ddlOffice");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetBranchOfficeList", "GroupwiseReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val, area_val: area_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {

                        ddlOffice.html('');
                        ddlOffice.append($('<option></option>').val("0").html("Please Select"));
                        $.each(data, function (id, option) {
                            ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlOffice").empty();
            }
        });


        $("#txtToDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });

        $("#txtFromDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });


        $("#btnView").click(function (e) {
            e.preventDefault();
            var ddlReportType = $("#ddlReportType").val();

            if (ddlReportType == "") {
                $.alert.open("Error", "Please Select Report View Option");
                $("#ddlReportType").focus();
                return false;
            }
            var Qtype;
            var office_id;


            var DateTo = $("#txtToDt").val();
            var DateFrom = $("#txtFromDt").val();

            Qtype = 1;
            var url = '/GroupwiseReport/GenerateFOWiseChangesReportNew?DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&ddlReportType=' + ddlReportType;
                //window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            if (ddlReportType === "xls") {
                // Initiate download
                window.location.href = url;
            } else {
                // Open in new window (e.g., for PDF or HTML)
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }

            //}
        });

    });
</script>

<h2 class="page-title">Changes Report</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="">
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date From", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtFromDt", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date To", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtToDt", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-4">
            <div class="form-group">
                <label class="control-label">Report View </label>
                <select class="form-control" id="ddlReportType">
                    <option value="" selected>Select</option>
                    <option value="pdf">Pdf</option>
                    <option value="xls">Excel</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="form-group form-action">
                <input type="submit" value="View" class="btn btn-primary" id="btnView" />
            </div>
        </div>
    </div>

</div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}

