
@{
    ViewBag.Title = "SamityListReport";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}


<script type="text/javascript">
    $(document).ready(function () {


        $("#btnView").click(function (e) {
            e.preventDefault();
            var CenterStatus = $("#ddlQtype").val();
            var DayFilter = $("#dayFilter").val();
            var exportType = $("#ddlExportType").val();

            if (DayFilter == "") {
                var url = '/GroupwiseReport/GenerateSamityListReport?CenterStatus=' + CenterStatus + '&ExportType=' + exportType;
            } else {
                var url = '/GroupwiseReport/GenerateSamityListReportWithDay?CenterStatus=' + CenterStatus + '&DaySelect=' + DayFilter + '&ExportType=' + exportType;
            }

            window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            //e.preventDefault();

            //var CenterStatus = $("#ddlQtype").val();

            //var DayFilter = $("#dayFilter").val();

            //if (DayFilter =="") {

            //    var url = '/GroupwiseReport/GenerateSamityListReport?CenterStatus=' + CenterStatus;
                
            //} else {

            //    var url = '/GroupwiseReport/GenerateSamityListReportWithDay?CenterStatus=' + CenterStatus + '&DaySelect=' + DayFilter;
               
            //}


          //  var url = '/GroupwiseReport/GenerateSamityListReport?CenterStatus=' + CenterStatus;

          

            //window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
        });
    });
</script>



<h2 class="page-title">Samity List Report</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="">

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    @Html.Label("Report", new { @class = "control-label" })
                    @Html.DropDownList("QtypeList", new[] {
                      new SelectListItem() {Text="Please Select", Value="9",Selected = true},
                      new SelectListItem() {Text="Drop", Value="0"},
                      new SelectListItem() {Text="Active",Value="1"}},
                      new { @ID = "ddlQtype", @class = "form-control" })
                </div>



                @*Day Select*@ 


                <div class="form-group">
                    @Html.Label("Day", new { @class = "control-label" })
                    @Html.DropDownList("DayList", new[] {
                      new SelectListItem() {Text="All Day", Value="",Selected = true},
                      new SelectListItem() {Text="Sunday", Value="Sunday"},
                      new SelectListItem() {Text="Monday",Value="Monday"},
                      new SelectListItem() {Text="Tuesday",Value="Tuesday"},
                      new SelectListItem() {Text="Wednesday",Value="Wednesday"},
                      new SelectListItem() {Text="Thursday",Value="Thursday"},
                      new SelectListItem() {Text="Friday",Value= "Friday" },
                      new SelectListItem() {Text="Saturday",Value= "Saturday" }},
                      new { @ID = "dayFilter", @class = "form-control" })
                </div>



            </div>


            <div class="col-md-8">&nbsp;</div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    @Html.Label("Export Type", htmlAttributes: new { @class = "control-label" })

                    @Html.DropDownList("ddlExportType", new List<SelectListItem> {
                    new SelectListItem { Text = "PDF", Value = "pdf", Selected = true },
                    new SelectListItem { Text = "Excel", Value = "excel" }
                }, new { @class = "form-control" })
                </div>
            </div>
        </div><h2 class="page-title"></h2>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group from-action">
                    <input type="submit" value="View" class="btn btn-primary" id="btnView" />
                </div>
            </div>
        </div>


    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}




