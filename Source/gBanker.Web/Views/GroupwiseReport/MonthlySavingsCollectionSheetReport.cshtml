
@{
    ViewBag.Title = "MonthlySavingsCollectionSheetReport";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<script type="text/javascript">
    //Main Product List

    function GetProductList() {

        var ddlProduct = $("#ddlMainProduct");
        $('#AjaxLoader').show();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetSavingsProductList", "GroupwiseReport", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                $('#AjaxLoader').hide();
                ddlProduct.html('');
                $.each(data, function (id, option) {
                    ddlProduct.append($('<option></option>').val(option.Value).html(option.Text));

                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    $(document).ready(function () {

        GetProductList();

        $("#txtToDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale"
        });

        $("#btnView").click(function (e) {
            e.preventDefault();
            var ProductCode = $("#ddlMainProduct").val();
            var DateTo = $("#txtToDt").val();
            var url;
            if (DateTo != '') {
                var url = '/GroupwiseReport/GenerateMonthlySavingsCollectionSheetReport?DateTo=' + DateTo + '&ProductCode=' + ProductCode;
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
            else {
                alert('Date field cannot be blank')
            }
        });
    });
</script>
<h2 class="page-title">Monthly Savings CollectionSheet Report</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    // ProductList
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Product", htmlAttributes: new { @class = "control-label" })
                @Html.DropDownList("ProductList", null, new { @ID = "ddlMainProduct", @class = "form-control" })
                @*@Html.TextBox(" ", "", new { @ID = "txtToDt", @class = "form-control" })*@
            </div>
        </div>
        <div class="col-md-8">&nbsp;</div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date To", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtToDt", @class = "form-control" })
            </div>
        </div>
    </div>
    <h2 class="page-title"></h2>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group from-action">
                <input type="submit" value="View" class="btn btn-primary" id="btnView" />
            </div>
        </div>
    </div>

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}




