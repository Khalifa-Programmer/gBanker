
@{
    ViewBag.Title = "Next Interest Payable";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        // Transaction Date
        $("#TransactionDate").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale",
                changeMonth: true,
                changeYear: true,
            });
        //$("#TransactionDate").datepicker(
        //    'setDate', new Date()
        //);

        // DateFrom
        $("#DateFrom").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale",
                changeMonth: true,
                changeYear: true,
            });
        //$("#DateFrom").datepicker(
        //    'setDate', new Date()
        //);

        // DateTo
        $("#DateTo").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale",
                changeMonth: true,
                changeYear: true,
            });
        //$("#DateTo").datepicker(
        //    'setDate', new Date()
        //);




        $('#dvNextPaymentDate').hide();

        $('#IsNextPayment').change(function () {
            if ($(this).is(':checked')) {
                $("#TransactionDate").val('');
                $("#TransactionDate").prop('disabled', true);
                $("#dvNextPaymentDate").show();
            } else {
                $("#dvNextPaymentDate").hide();
                $("#TransactionDate").prop('disabled', false);
            }

        });


        //Click Button View Report
        $("#btnView").click(function (e) {
            e.preventDefault();
            var url;
            var trxDate = $("#TransactionDate").val();
            var dateFrom = $("#DateFrom").val();
            var dateTo = $("#DateTo").val();
            var isNextPayChecked = $('#IsNextPayment').is(':checked');
            if (isNextPayChecked) {
                url = '/GroupwiseReport/GenerateNextInterestPayableReport?qType=2&TrxDate=' + trxDate + '&DateFrom=' + dateFrom + '&DateTo=' + dateTo;
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            } else {
                url = '/GroupwiseReport/GenerateNextInterestPayableReport?qType=1&TrxDate=' + trxDate + '&DateFrom=' + dateFrom + '&DateTo=' + dateTo;
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
        });
    });
</script>
<h2 class="page-title">Next Interest Payable</h2>

<div class="">
    <div class="row">
        <div class="col-md-4">
            <label class="control-label" style="padding-top:0px;">Transaction Date :</label>
            <input type="text" id="TransactionDate" placeholder="Select Transaction Date" autocomplete="off" class="form-control" />
        </div>
        <div class="col-md-8">&nbsp;</div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-4">
            <label class="control-label" style="padding-top:0px;">Next Payment Date :</label>
            <input type="checkbox" id="IsNextPayment" class="checkbox" />
        </div>
        <div class="col-md-8">&nbsp;</div>
    </div>

    <div id="dvNextPaymentDate">
        <div class="row">
            <div class="col-md-4">
                <label class="control-label" style="padding-top:0px;">Date From:</label>
                <input type="text" id="DateFrom" placeholder="Select Date From" autocomplete="off" class="form-control" />
            </div>
            <div class="col-md-8">&nbsp;</div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-4">
                <label class="control-label" style="padding-top:0px;">Date To: </label>
                <input type="text" id="DateTo" placeholder="Select Date To" autocomplete="off" class="form-control" />
            </div>
            <div class="col-md-8">&nbsp;</div>
        </div>
    </div>



    <h2 class="page-title"></h2>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group from-action">
                <input type="submit" value="View" class="btn btn-primary" id="btnView" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}




