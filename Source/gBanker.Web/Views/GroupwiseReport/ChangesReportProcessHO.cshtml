
@{
    ViewBag.Title = "Changes Report Process HO";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#txtFromDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale",
                changeMonth: true,
                changeYear: true
            });
        $("#txtToDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale",
                changeMonth: true,
                changeYear: true
            });


        $('#btnProcess').click(function () {
            $('#btnProcess').prop("disabled", true);
            $('#btnProcess').html("<i class='fa fa-spinner fa-pulse'></i> Process is running...");

            var fromDate = $("#txtFromDt").val();
            var toDate = $("#txtToDt").val();
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '/GroupWiseReport/Run_ChangesReportProcessHO',
                data: { fromDate: fromDate, toDate: toDate },
                dataType: 'json',
                async: true,
                success: function (response) {
                    $('#btnProcess').prop("disabled", false)
                    $('#btnProcess').html("Process")
                    $.alert.open(response.Msg);
                },
                error: function (request, status, error) {
                    $.alert.open(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        })
    });
    

</script>

<h2 class="page-title">Changes Report Process HO</h2>

<div class="">
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date From", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"].ToString(), new { @ID = "txtFromDt", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                @Html.Label("Date To", new { @class = "control-label" })
                @Html.TextBox(" ", ViewData["TrxDate"].ToString(), new { @ID = "txtToDt", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group form-action">
                @*<input type="submit" value="Process"  />*@
                <button class="btn btn-primary" id="btnProcess" type="submit">
                    Process
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}
