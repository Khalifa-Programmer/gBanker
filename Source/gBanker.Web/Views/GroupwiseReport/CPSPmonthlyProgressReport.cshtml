         CheckOffcLevel();
        $("#dv").hide();
/*        GetHO();*/
        $("input[type='radio']").on("change", function (e) {
            if (e.target.id == "rdDivision" && e.target.checked) {
                $("#ddlZone").val('');
               // $("#ddlZone").attr("readonly", true)
                $("#ddlOffice").val('');
                $("#ddlArea").val('');
                $("#ddlArea").attr("readonly", true)
                $("#ddlOffice").attr("readonly", true)
                $("#dv").show();
                $("#dvZone").hide();
                getDivisionAndRegion('/Office/DivisionShow', $("#ddlDivision"))
            }
            else {
                $("#ddlZone").attr("readonly", false)
                $("#ddlOffice").attr("readonly", false)
                $("#ddlArea").attr("readonly", false)
                $("#ddlDivision").empty();
                $("#ddlProgram").empty();
                $("#dv").hide();
                $("#dvZone").show();
            }
        })

        function getDivisionAndRegion(url, ddl) {
            //debugger
            ddl.html('');
            ddl.append($('<option></option>').val("").html("Please Select"));

            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: url,
                //data: { HO_val: HO_val, zone_val: zone_val },
                dataType: 'json',
                async: true,
                success: function (data) {


                    $.each(data, function (id, option) {
                        ddl.append($('<option></option>').val(option.Value).html(option.Text));
                    });

                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
        $("#ddlDivision").change(function () {

            getDivisionAndRegion('/Office/RegionShow?rdID=' + ($(this).val() ? $(this).val() : '-1') + '', $("#ddlProgram"))
        });

        $("#ddlZone").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            if (HO_val > 0 && zone_val > 0) {
                var ddlArea = $("#ddlArea");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetAreaList", "GroupwiseReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlArea.html('');
                        ddlArea.append($('<option></option>').val("0").html("Please Select"));
                        $.each(data, function (id, option) {
                            ddlArea.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        $("#ddlOffice").empty();
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlArea").empty();
                $("#ddlOffice").empty();
            }
        });
        $("#ddlArea").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            var area_val = $("#ddlArea").val();
            if (HO_val > 0 && zone_val > 0 && area_val > 0) {
                var ddlOffice = $("#ddlOffice");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetBranchOfficeList", "GroupwiseReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val, area_val: area_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {

                        ddlOffice.html('');
                        ddlOffice.append($('<option></option>').val("0").html("Please Select"));
                        $.each(data, function (id, option) {
                            ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlOffice").empty();
            }
        });



        $("#txtFromDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });
         $("#txtToDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });


        $("#btnView").click(function (e) {
            e.preventDefault();
            //var DateFrom = $("#txtFromDt").val();

            var ReportType = $("#ReportType").val();
            var ReportName = $("#ReportName").val();

            if (ReportType == "0" || ReportType == "") {
                $.alert.open('Error', 'Please select report type');
                $("#ReportType").focus();
                return;
            }

            if (ReportName == "0" || ReportName == "") {
                $.alert.open('Error', 'Please select report name');
                $("#ReportName").focus();
                return;
            }


            var DateTo = $("#txtToDt").val();

            var Qtype;
            var office_id;

            var DateTo = $("#txtToDt").val();

            if ($("#ddlHO").val() > 0) {
                office_id = $("#ddlHO").val();
                Qtype = 1;
                if ($("#rdDivision").prop('checked')) {
                    if ($("#ddlProgram").val()) {
                        Qtype = 7;
                        office_id = $("#ddlProgram").val();
                    }
                    else if ($("#ddlDivision").val()) {
                        Qtype = 6;
                        office_id = $("#ddlDivision").val();
                    }
                }
                else {
                    if ($("#ddlZone").val() > 0) {
                        Qtype = 1;
                        if ($("#ddlArea").val() > 0) {
                            Qtype = 2;
                            if ($("#ddlOffice").val() > 0) {
                                Qtype = 3;
                                office_id = $("#ddlOffice").val();
                            }
                            else {
                                office_id = $("#ddlArea").val();
                            }
                        }
                        else {
                            office_id = $("#ddlZone").val();
                        }
                    }
                    else {
                        office_id = $("#ddlHO").val();
                    }
                }

                var OrganizationId = $('#OrganizationId').val();
                var OrganizationAutoComplete = $('#OrganizationAutoComplete').val();
                var EmployeeAutoComplete = $('#EmployeeAutoComplete').val();

                if (OrganizationAutoComplete != "") {
                    Qtype = 0;
                }

                if (EmployeeAutoComplete != "") {
                    Qtype = 4;
                }



                var ZoneID = $('#ddlZone').val();
                var AreaID = $('#ddlArea').val();
                var BranchID = $('#ddlOffice').val();
                var EmployeeID = $('#EmployeeID').val();

                var memberID = 0;
                var centerID = 0;

                var url = '/GroupwiseReport/GenerateCPSPmonthlyProgressReportNew?Qtype=' + Qtype + '&OfficeId=' + office_id + '&DateTo=' + DateTo + '&ZoneID=' + ZoneID + '&AreaID=' + AreaID + '&BranchID=' + BranchID + '&EmployeeID=' + EmployeeID + '&memberID=' + memberID + '&centerID=' + centerID + '&ReportType=' + ReportType + '&ReportName=' + ReportName;
                   window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }



        });



        $("#txtToDt").change(function (e) {
            e.preventDefault();

        });
    });



</script>
<h2 class="page-title">CPSP Monthly Progress Report </h2>
@using (Html.BeginForm())
