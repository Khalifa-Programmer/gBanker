         $("#EmployeeAutoComplete").autocomplete({
        source: function (request, response) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetEmployeeList_CPSP", "GroupwiseReport", "http")',
                type: "GET",
                dataType: 'json',
                async: true,
                data: { Employeeid: request.term, OfficeId: $("#ddlOffice").val() },
                minLength: 1,
                success: function (data) {
                    response($.map(data, function (item) {
                        return {
                            value: item.EmployeeID,
                            label: item.EmpName
                        };
                        //response(data);
                    }))
                }
            })
        },
        messages: {
            noResults: "", results: ""
        },
        focus: function (event, ui) {
            $("#EmployeeAutoComplete").val(ui.item.label);
            return false;
        },
        select: function (event, ui) {
            $("#EmployeeAutoComplete").val(ui.item.label);
            $("#EmployeeID").val(ui.item.value);
            return false;
        },
        change: function (event, ui) {
            $("#EmployeeAutoComplete").val(ui.item.label);
            $("#EmployeeID").val(ui.item.value);
            return false;
        }
      });


         $("#OrganizationAutoComplete").blur(function () {
