        <div class="row" id="div_staff" style="display:none;">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Staff", htmlAttributes: new { @class = "control-label" })
                    @*<span style="color:red; font-size:15px;"> * </span>*@
                    @Html.TextBox("EmployeeAutoComplete", "", new { @class = "form-control" })
                    @Html.HiddenFor(model => model.EmployeeID)
                    @Html.TextBoxFor(model => model.EmployeeID, new { @style = "display:none" })
                    @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row" id="div_reportname" style="display:none;">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Report Name", new { @class = "control-label" })
                    @Html.DropDownList("ReportNameList", null, new { @ID = "ReportName", @class = "form-control" })
                </div>
            </div>
        </div>



        <h2 class="page-title"></h2>
        <div class="row">
            <div class="col-md-12">


                <input type="submit" value="View" class="btn btn-primary" id="btnView" />

            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
}


