                </div>
            </div>
        </div>
        <div class="row" id="div_upozila" style="display:none;">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Upazila", new { @class = "control-label" })
                    @Html.DropDownList("OfficeList", null, new { @ID = "ddlOffice", @class = "form-control" })
                </div>
            </div>
        </div>

