    function deleteMRASubjectDetails(memberid) {
        if (confirm("Are you sure you want to delete this item?")) {
            $.ajax({
                url: "/GroupwiseReport/DeleteMRASubjectDetails",
                method: "POST",
                data: { memberid: memberid },
                dataType: "json",
                success: function (result) {
                    //console.log(result);
                    if (result.success) {
                        $("#dvMessage").attr('class', "success");
                        $("#dvMessage").html(result.message);
                        $("#dvMessage").show();
                        if (response.Message == null)
                            $("#dvMessage").toggle('fade', 1500);

                        $('#grid').jtable('destroy');
                        loadGrid_SubjectDetails('get_MRASubjectDetails', office_id, DateTo);
                    }
                    else {
                        alert(result.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error:", error);
                }
            });
        }
    }

