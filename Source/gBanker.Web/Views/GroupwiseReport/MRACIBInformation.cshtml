    function reloadGridSubmit() {
        var office_id;
        var DateTo = $("#Date2").val();
        var branch = $("#txtBranch").val();

        if ($("#ddlHO").val() > 0) {
            office_id = $("#ddlHO").val();

            if ($("#rdDivision").prop('checked')) {
                if ($("#ddlProgram").val()) {
                    Qtype = 7;
                    office_id = $("#ddlProgram").val();
                }
                else if ($("#ddlDivision").val()) {
                    Qtype = 6;
                    office_id = $("#ddlDivision").val();
                }
            }
            else {
                if ($("#ddlZone").val() > 0) {
                    if ($("#ddlArea").val() > 0) {
                        var officeVal = $("#ddlOffice").val();
                        if (officeVal && officeVal.length > 0) {
                            office_id = officeVal;
                        }
                        else {
                            office_id = $("#ddlArea").val();
                        }
                    }
                    else {
                        office_id = $("#ddlZone").val();
                    }
                }
                else {
                    office_id = $("#ddlHO").val();
                }
            }
        }

        if ($("#Date2").val() == "") {
            alert("Please Give ToDate Date.");
            return false;
        }


        if (!isContractDetailsClicked) {
            if (!isGridInitialized) {
                $("#btnViewSubDetails").trigger("click");
            } else {
                $('#grid').jtable('destroy');
                loadGrid_SubjectDetails('get_MRASubjectDetails', office_id, DateTo, branch);
            }
        }
        else {
            if (!isGridInitialized) {
                $("#btnViewConDetails").trigger("click");
            } else {
                $('#grid').jtable('destroy');
                loadGrid_ContractDetails('get_MRAContractDetails', office_id, DateTo, branch);
            }
        }

    }

    function reloadGrid() {
        $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
    }

    </script>

