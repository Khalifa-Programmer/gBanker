@{
    ViewBag.Title = "Generate MRA CIB Information";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<style type="text/css">
    th {
        height: 40px;
        vertical-align: top;
        margin-top: 0px !important;
        padding-top: 0px !important;
    }

    span.jtable-column-header-text {
        margin-top: 0px !important;
    }
</style>


<h2 class="page-title">Generate MRA CIB Information</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Head Office", new { @class = "control-label" })
                    @Html.DropDownList("HOList", null, new { @ID = "ddlHO", @class = "form-control", @readonly = "true" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" style="margin-top:27px">
                    <input type="radio" id="rdZone" name="under" checked="checked">
                    <label for="under">Zone Wise</label>
                    <br>
                </div>
            </div>
        </div>
        <!--<div id="dv">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Program/Project</label>
                        <select class="form-control" id="ddlDivision"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Division/Region</label>
                        <select class="form-control" id="ddlProgram"></select>
                    </div>
                </div>
            </div>
        </div>-->
        <div id="dvZone">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.Label("Zone Office", new { @class = "control-label" })
                        @Html.DropDownList("ZoneList", null, new { @ID = "ddlZone", @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.Label("Area Office", new { @class = "control-label" })
                        @Html.DropDownList("AreaList", null, new { @ID = "ddlArea", @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.Label("Office", new { @class = "control-label" })
                        @Html.DropDownList("OfficeList", null, new { @ID = "ddlOffice", @multiple = "multiple", @class = "ddl-select-picker form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Date To", new { @class = "control-label" })
                    @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtToDt", @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12" align="left">
                <div class="form-group form-action" style="margin-top:10px">
                    <input type="button" value="CIB_Subject_Details" class="btn btn-primary" id="btnViewSubDetails" />
                    &nbsp;
                    <input type="button" value="CIB_Contract_Details" class="btn btn-primary" id="btnViewConDetails" />

                    <input type="checkbox" id="chkFilter" class="btn btn-primary">
                </div>
            </div>
        </div>
    </div>
}

<!--Add filtering section-->
<div id="divFilter" class="row" style="display: none;">
    <div class="col-md-3">
        <label class="control-label" style="padding-top:0px;">Date</label>
        <input type="text" id="Date2" placeholder="Type Search Text" autocomplete="off" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="control-label" style="padding-top:0px;">Branch</label>
        <input type="text" id="txtBranch" placeholder="Branch" autocomplete="off" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="control-label">Filter By:</label>
        <select id="filterColumn" class="form-control">
            <option value="">All</option>
            <option value="member">Member Code</option>
            <option value="datastatus">Data Status</option>
        </select>
    </div>
    <div class="col-md-4">
        <div class="row" style="margin-top: 21px;">
            <div class="col-md-9">
                <input type="text" id="filterValue" placeholder="Type Search Text" class="form-control" />
            </div>
            <div class="col-md-3">
                <input type="button" id="btnSearch" value="Search" class="btn btn-primary" onclick="reloadGridSubmit();" />
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12">
        &nbsp;
    </div>
</div>


<div class="">
    <div id="grid"></div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")

    <link href="~/Assets/js/plugins/boostrap-selelect/bootstrap-select.min.css" rel="stylesheet" />
    <script src="~/Assets/js/plugins/boostrap-selelect/bootstrap-select.min.js"></script>

    <script type="text/javascript">

    var isGridInitialized = false; // ✅ Declare globally
    var isContractDetailsClicked = false;

    function GetZoneOffice() {
        var HO_val = $("#ddlHO").val();
        if (HO_val > 0) {
            var ddlZone = $("#ddlZone");
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetZoneList", "GroupwiseReport", "http")',
                data: { HO_val: HO_val },
                dataType: 'json',
                async: true,
                success: function (data) {
                    ddlZone.html('');
                    ddlZone.append($('<option></option>').val("0").html("Please Select"));
                    $.each(data, function (id, option) {
                        ddlZone.append($('<option></option>').val(option.Value).html(option.Text));
                    });
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
        else {
            $("#ddlZone").empty();
            $("#ddlArea").empty();
            $("#ddlOffice").empty();
        }
    }

    function GetHO() {
        var ddlHO = $("#ddlHO");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetHOList", "GroupwiseReport", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlHO.html('');
                $.each(data, function (id, option) {
                    ddlHO.append($('<option></option>').val(option.Value).html(option.Text));
                });
                GetZoneOffice();
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    $(document).ready(function () {
        $("#dv").hide();
        GetHO();
        $("input[type='radio']").on("change", function (e) {
            if (e.target.id == "rdDivision" && e.target.checked) {
                $("#ddlZone").val('');
                $("#ddlZone").attr("readonly", true)
                $("#ddlOffice").val('');
                $("#ddlArea").val('');
                $("#ddlArea").attr("readonly", true)
                $("#ddlOffice").attr("readonly", true)
                $("#dv").show();
                $("#dvZone").hide();
            }
            else {
                $("#ddlZone").attr("readonly", false)
                $("#ddlOffice").attr("readonly", false)
                $("#ddlArea").attr("readonly", false)
                $("#dv").hide();
                $("#dvZone").show();
            }
        })

        function getDivisionAndRegion(url, ddl) {
            ddl.html('');
            ddl.append($('<option></option>').val("").html("Please Select"));

            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: url,
                //data: { HO_val: HO_val, zone_val: zone_val },
                dataType: 'json',
                async: true,
                success: function (data) {


                    $.each(data, function (id, option) {
                        ddl.append($('<option></option>').val(option.Value).html(option.Text));
                    });

                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }

        $("#ddlZone").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            if (HO_val > 0 && zone_val > 0) {
                var ddlArea = $("#ddlArea");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetAreaList", "GroupwiseReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlArea.html('');
                        ddlArea.append($('<option></option>').val("0").html("Please Select"));
                        $.each(data, function (id, option) {
                            ddlArea.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        $("#ddlOffice").empty();
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlArea").empty();
                $("#ddlOffice").empty();
            }
        });
        $("#ddlArea").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            var area_val = $("#ddlArea").val();
            if (HO_val > 0 && zone_val > 0 && area_val > 0) {
                var ddlOffice = $("#ddlOffice");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetBranchOfficeList", "GroupwiseReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val, area_val: area_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlOffice.html('');
                        //ddlOffice.append($('<option></option>').val("0").html("Please Select"));
                        //$.each(data, function (id, option) {
                        //    ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                        //});
                        $.each(data, function (id, option) {
                            var selected = option.Selected ? 'selected="selected"' : '';
                            ddlOffice.append($(`<option ${selected}></option>`).val(option.Value).html(option.Text));
                        });

                        $('.ddl-select-picker').selectpicker('refresh');
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlOffice").empty();
            }
        });


        $("#txtToDt").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true
        });

        $("#Date2").datepicker({
            dateFormat: "ddmmyy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true
        });


        $('.ddl-select-picker').selectpicker();


        //let isGridInitialized = false;
        $("#btnViewSubDetails").click(function () {
            var office_id;
            var DateTo = $("#txtToDt").val();

            $("#Date2").datepicker('setDate', $.datepicker.parseDate('dd-M-yy', DateTo));

            if ($("#ddlHO").val() > 0) {
                office_id = $("#ddlHO").val();

                if ($("#rdDivision").prop('checked')) {
                    if ($("#ddlProgram").val()) {
                        Qtype = 7;
                        office_id = $("#ddlProgram").val();
                    }
                    else if ($("#ddlDivision").val()) {
                        Qtype = 6;
                        office_id = $("#ddlDivision").val();
                    }
                }
                else {
                    if ($("#ddlZone").val() > 0) {
                        if ($("#ddlArea").val() > 0) {
                            var officeVal = $("#ddlOffice").val();
                            if (officeVal && officeVal.length > 0) {
                                office_id = officeVal;
                            }
                            else {
                                office_id = $("#ddlArea").val();
                            }
                        }
                        else {
                            office_id = $("#ddlZone").val();
                        }
                    }
                    else {
                        office_id = $("#ddlHO").val();
                    }
                }
            }

            $('#divFilter').show();

            if (isGridInitialized) {
                $('#grid').jtable('destroy');
            }


            loadGrid_SubjectDetails('generate_MRASubjectDetails', office_id, DateTo);

        });



        $("#btnViewConDetails").click(function (e) {
            var office_id;
            var DateTo = $("#txtToDt").val();

            $("#Date2").datepicker('setDate', $.datepicker.parseDate('dd-M-yy', DateTo));

            if ($("#ddlHO").val() > 0) {
                office_id = $("#ddlHO").val();

                if ($("#rdDivision").prop('checked')) {
                    if ($("#ddlProgram").val()) {
                        Qtype = 7;
                        office_id = $("#ddlProgram").val();
                    }
                    else if ($("#ddlDivision").val()) {
                        Qtype = 6;
                        office_id = $("#ddlDivision").val();
                    }
                }
                else {
                    if ($("#ddlZone").val() > 0) {
                        if ($("#ddlArea").val() > 0) {
                            var officeVal = $("#ddlOffice").val();
                            if (officeVal && officeVal.length > 0) {
                                office_id = officeVal;
                            }
                            else {
                                office_id = $("#ddlArea").val();
                            }
                        }
                        else {
                            office_id = $("#ddlZone").val();
                        }
                    }
                    else {
                        office_id = $("#ddlHO").val();
                    }
                }
            }

            $('#divFilter').show();

            // 💥 Destroy the existing jTable grid
            if (isGridInitialized) {
                $('#grid').jtable('destroy');
            }

            loadGrid_ContractDetails('generate_MRAContractDetails', office_id, DateTo);

        });

        $('#chkFilter').change(function () {
            $('#divFilter').toggle(this.checked);
        });

    });

    function loadGrid_SubjectDetails(callType, office_id, DateTo, branch) {
        $('#grid').jtable({
            paging: true,
            pageSize: 30,
            sorting: true,
            defaultSorting: 'OfficeId',
            actions: {
                listAction: function (postData, jtParams) {
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            //url: '/GroupWiseReport/GenerateMRASubjectDetails?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&officeId=' + office_id + '&dateTo=' + DateTo,
                            url: '/GroupWiseReport/GenerateMRASubjectDetails?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting +
                                '&callType=' + callType + '&officeId=' + office_id + '&dateTo=' + DateTo + '&branch=' + branch,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
