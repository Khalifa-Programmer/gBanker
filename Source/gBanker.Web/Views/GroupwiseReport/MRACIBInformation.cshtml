<h2 class="page-title">Generate MRA CIB Information</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Head Office", new { @class = "control-label" })
                    @Html.DropDownList("HOList", null, new { @ID = "ddlHO", @class = "form-control", @readonly = "true" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" style="margin-top:27px">
                    <input type="radio" id="rdZone" name="under" checked="checked">
                    <label for="under">Zone Wise</label>
                    <br>
                </div>
            </div>
        </div>
        <!--<div id="dv">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Program/Project</label>
                        <select class="form-control" id="ddlDivision"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Division/Region</label>
                        <select class="form-control" id="ddlProgram"></select>
                    </div>
                </div>
            </div>
        </div>-->
        <div id="dvZone">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.Label("Zone Office", new { @class = "control-label" })
                        @Html.DropDownList("ZoneList", null, new { @ID = "ddlZone", @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.Label("Area Office", new { @class = "control-label" })
                        @Html.DropDownList("AreaList", null, new { @ID = "ddlArea", @class = "form-control" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        @Html.Label("Office", new { @class = "control-label" })
                        @Html.DropDownList("OfficeList", null, new { @ID = "ddlOffice", @multiple = "multiple", @class = "ddl-select-picker form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Date To", new { @class = "control-label" })
                    @Html.TextBox(" ", ViewData["TrxDate"], new { @ID = "txtToDt", @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12" align="left">
                <div class="form-group form-action" style="margin-top:10px">
                    <input type="button" value="CIB_Subject_Details" class="btn btn-primary" id="btnView" />
                    &nbsp;
                    <input type="button" value="CIB_Contract_Details" class="btn btn-primary" id="btnViewConDetails" />
                </div>
            </div>
        </div>
    </div>
}


<div class="">
    <div id="grid"></div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")

    <link href="~/Assets/js/plugins/boostrap-selelect/bootstrap-select.min.css" rel="stylesheet" />
