@model gBanker.Web.Models.PasswordChangeModel

@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_ResetPasswordLayout.cshtml";
}

<style>
    #toggleNewPassword, #toggleCurrentPassword {
        cursor: pointer;
    }
</style>
<script type="text/javascript">
    $(document).ready(function () {

        $('#toggleCurrentPassword').click(function () {
            var currentPasswordField = $('#CurrentPassword');
            var currentPasswordFieldType = currentPasswordField.attr('type');
            var eyeIconCurrentPassword = $('#eyeIconCurrentPassword');

            if (currentPasswordFieldType === 'password') {
                currentPasswordField.attr('type', 'text');
                eyeIconCurrentPassword.removeClass('glyphicon-eye-open').addClass('glyphicon-eye-close');
            } else {
                currentPasswordField.attr('type', 'password');
                eyeIconCurrentPassword.addClass('glyphicon-eye-open').removeClass('glyphicon-eye-close');
            }
        });

        $('#toggleNewPassword').click(function () {

            var newPasswordField = $('#NewPassword');
            var newPasswordFieldType = newPasswordField.attr('type');
            var eyeIconNewPassword = $('#eyeIconNewPassword');

            if (newPasswordFieldType === 'password') {
                newPasswordField.attr('type', 'text');
                eyeIconNewPassword.removeClass('glyphicon-eye-open').addClass('glyphicon-eye-close');
            } else {
                newPasswordField.attr('type', 'password');
                eyeIconNewPassword.addClass('glyphicon-eye-open').removeClass('glyphicon-eye-close');
            }
        });

        


        $('#NewPassword').on('input', function () {
            // Reset error message
            $('#newPasswordError').text('');

            // Get the entered password
            var newPassword = $(this).val();

            // Define the regular expressions for validation
            var specialCharRegex = /[!#$%^&*(),.?":{}|<>]/;
            var capitalLetterRegex = /[A-Z]/;
            var numberRegex = /[0-9]/;

            // Check the length of the password
            if (newPassword.length < 6 || newPassword.length > 16) {
                $('#newPasswordError').text('Password must be between 6 and 16 characters.');
                $("#btnChangePass").prop('disabled', true);
                return;
            } else {
                $("#btnChangePass").prop('disabled', false)
            }

            // Check for at least one special character, one capital letter, and one number
            if (!specialCharRegex.test(newPassword) || !capitalLetterRegex.test(newPassword) || !numberRegex.test(newPassword)) {
                $('#newPasswordError').text('Password must have at least one special character, one capital letter, and one number.');
                $("#btnChangePass").prop('disabled', true)
                return;
            } else {
                $("#btnChangePass").prop('disabled', false)
            }
        });
    });

</script>

@using (Html.BeginForm("ChangeCurrentPassword", "Account", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    <fieldset>
        <div class="row">
            @if (ViewBag.IsSuccess == true)
            {
                <div class="alert alert-success" role="alert">
                    Password Changed Successfully
                </div>
            }
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="input-group input-group-lg">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i></span>
                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @placeholder = "Username" })
                </div>
            </div>
            <div class="col-md-12">
                <div class="input-group input-group-lg center">
                    @Html.ValidationMessageFor(m => m.UserName)
                </div>
            </div>
        </div>

        <div class="clearfix"></div><br />
        <div class="row">
            <div class="col-md-12">
                <div class="input-group input-group-lg">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", @placeholder = "Current Password" })
                    <span class="input-group-addon" id="toggleCurrentPassword">
                        <i class="glyphicon glyphicon-eye-open" id="eyeIconCurrentPassword"></i>
                    </span>
                </div>
            </div>

            <div class="col-md-12">
                <div class="input-group input-group-lg center">
                    @Html.ValidationMessageFor(m => m.CurrentPassword)
                </div>
            </div>
        </div>

        <div class="clearfix"></div><br />
        <div class="row">
            <div class="col-md-12">
                <div class="input-group input-group-lg">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-briefcase"></i></span>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", @placeholder = "New Password" })
                    <span class="input-group-addon" id="toggleNewPassword">
                        <i class="glyphicon glyphicon-eye-open" id="eyeIconNewPassword"></i>
                    </span>
                </div>
            </div>

            <div class="col-md-12">
                <div class="input-group input-group-lg center">
                    @Html.ValidationMessageFor(m => m.NewPassword)
                    <span id="newPasswordError" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="clearfix"></div><br />
        <div class="row">
            <div class="col-md-5 col-sm-5 col-xs-8 center">
                <button type="submit" id="btnChangePass" class="btn btn-primary">Change Password</button>
            </div>
        </div>
    </fieldset>
    <br />
    <div class="row">
        <div class="col-md-5 col-sm-5 col-xs-8 center">
            @Html.ActionLink("Back To Login", "Login")
        </div>
    </div>
}

