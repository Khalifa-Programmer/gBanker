@model gBanker.Web.ViewModels.ProMiniBalanSetViewModel

@{
    ViewBag.Title = "ProMiniBalanceSet Create";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";

    var product = Model == null ? null : Model.productListItems;
    <link href="~/Content/jtable-custom.css" rel="stylesheet" />
    <link href="~/Content/css/kendo/kendo.common.min.css" rel="stylesheet" />
    <link href="~/Content/css/kendo/kendo.bootstrap.min.css" rel="stylesheet" />

}

@if (TempData["message"] != null)
{
    <script>
    $.alert.open('@TempData["message"]');

    </script>
}

<style type="text/css">
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        background: rgba( 255, 255, 255, .8 ) url('http://i.stack.imgur.com/FhHRx.gif') 50% 50% no-repeat;
    }

    /* When the body has the loading class, we turn
    the scrollbar off with overflow:hidden */
    body.loading {
        overflow: hidden;
    }

        /* Anytime the body has the loading class, our
    modal element will be visible */
        body.loading .modal {
            display: block;
        }
</style>
<script type="text/javascript">


    $(document).ready(function () {

        $body = $("body");

        function SetProductid(value) {

            var ddlValue = $("#ProductID option:selected").val();
            $("#hfProdId").val(ddlValue);

        }

        $("#EffectiveDateFrom").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });

        $("#EffectiveDateTo").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });

        $("#btnSubmit").click(function (e) {
            e.preventDefault();

            var ProductId = $("#ProductId").val();
            var MinimumBalance = $("#MinimumBalance").val();

            var DateFrom = $("#EffectiveDateFrom").val();
            var DateTo = $("#EffectiveDateTo").val();


            if (ProductId == '0') {
                alert('Please select a product! ')
                return false;
            }
            if (MinimumBalance == '0.00' || MinimumBalance == '') {
                alert('Minimum balance can not be empty or greater than 0 ')
                return false;
            }



            // var url;
            if (DateFrom == '') {
                alert('Effective Date From field cannot be blank')
                return false;
            }

            if (DateTo == '') {
                alert('Effective Date To field cannot be blank')
                return false;
            }

            if ((Date.parse(DateTo) <= Date.parse(DateFrom))) {
                alert("Effective Date To should be greater than Effective Date From");
                document.getElementById("EffectiveDateTo").value = "";
                document.getElementById("EffectiveDateFrom").value = "";
                return false;
            }

            document.getElementById('prominibal').submit();

        });


        var ProductId = $("#ProductId").val();

           $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetListForProMiniBalanSet", "AccBalanceSheet", "http")',
                    dataType: 'json',
                    data: { ProductId: ProductId }
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "MinimumBalanceID",
                    hidden: true,
                    filterable: false
                },

                {
                    field: "rowSl",
                    title: "SL",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "ProductId",
                    title: "ProductId",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "MinimumBalance",
                    title: "MinimumBalance",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "EffectiveDateFrom",
                    title: "EffectiveDateFrom",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "EffectiveDateTo",
                    title: "EffectiveDateTo",
                    width: "35px",
                    filterable: true,
                },
                //{
                //    field: "CreatedOn",
                //    title: "CreatedOn",
                //    width: "40px",
                //    filterable: true,
                //},



                {
                    title: "Edit",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a  href='#' OnClick='Edit(" + dataItem.MinimumBalanceID + ");'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },



                 {
                     title: "Delete",
                     width: "20px",
                     template: function (dataItem) {
                         return "<a href='#' OnClick='Delete(" + dataItem.MinimumBalanceID + ");'><i class='fa fa-trash-o'></i></a>";
                     }
                 },

            ]
        });
    });


    function Edit(MinimumBalanceID) {
        console.log(MinimumBalanceID);

         $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDataForProMiniBalanSet", "AccBalanceSheet")',
            type: "GET",
            dataType: 'json',
            async: true,
             data: { MinimumBalanceID: MinimumBalanceID },

            success: function (result) {
                $("#MinimumBalance").val(result.MinimumBalance);
                $("#MinimumBalanceID").val(result.MinimumBalanceID);
                $("#ProductId").val(result.ProductId);
                $("#EffectiveDateFrom").val(result.EffectiveDateFrom);
                $("#EffectiveDateTo").val(result.EffectiveDateTo);
               // $("#IsDefault").val(result.IsDefault);
                if (result.IsDefault == "True") {
                    $('#IsDefault').prop('checked', true);
                }
                else {
                    $('#IsDefault').removeAttr('checked');
                }


            },
            error: function (error) {
                //alert('error');
            }
        });



    }

    function Delete(MinimumBalanceID) {
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {
                console.log(MinimumBalanceID);
                url = '/AccBalanceSheet/DeleteProMiniBalanSet?MinimumBalanceID=' + MinimumBalanceID;
                window.open(url, '_blank');
            }
        });
    }

</script>

@*@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right" })*@

<h2 class="page-title">Add Pro Balance </h2>

@using (Html.BeginForm("CreateProMiniBalan", "AccBalanceSheet", FormMethod.Post, new { enctype = "multipart/form-data", id = "prominibal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.MinimumBalanceID)
    <div class="">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })



        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ProductId, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.ProductId, product, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger" })
                </div>

            </div>
        </div>





        <div class="row">
            <div class="col-md-6">
                <div class="form-group">

                    @Html.LabelFor(model => model.MinimumBalance, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.MinimumBalance, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.MinimumBalance, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(model => model.EffectiveDateFrom, htmlAttributes: new { @class = "control-label" })

                    @Html.EditorFor(model => model.EffectiveDateFrom, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EffectiveDateFrom, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(model => model.EffectiveDateTo, htmlAttributes: new { @class = "control-label" })

                    @Html.EditorFor(model => model.EffectiveDateTo, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.EffectiveDateTo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">


                    @Html.CheckBoxFor(model => model.IsDefault, new { @checked = "checked" })

                    @Html.LabelFor(model => model.IsDefault, htmlAttributes: new { @class = "" })

                    @Html.ValidationMessageFor(model => model.IsDefault, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="form-group form-action">
                <input type="submit" id="btnSubmit" value="Save" class="btn btn-primary" />
            </div>
        </div>
    </div>


    <br />
    <div class="row">
        <div class="col-md-12">
            <div id="gridKendo"></div>
        </div>
    </div>
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
}


<script src="~/Content/js/KendoJs/kendo.all.min.js"></script>
<script src="~/Content/js/KendoJs/kendo.aspnetmvc.min.js"></script>
