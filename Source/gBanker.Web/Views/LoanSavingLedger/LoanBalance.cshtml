
@{
    ViewBag.Title = "Loan Balance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}



<script type="text/javascript">
    function GetCenter() {
        var ddlCenter = $("#ddlCenter");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCenterList", "LoanSavingLedger", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlCenter.html('');
                $.each(data, function (id, option) {
                    ddlCenter.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.status + "/" + error);
            }
        });

    }
    $(document).ready(function () {
        GetCenter();

        
        $("#btnView").click(function (e) {
            e.preventDefault();
            Excel();
            Pdf(); 
        });

        function Excel() {
            var url;
            var center = $("#ddlCenter").val();
            if (center > 0) {
                url = '/LoanSavingLedger/GenerateLoanBalanceReportExcel?Qtype=2&Center=' + center;
            }
            else if (center == 0) {
                url = '/LoanSavingLedger/GenerateLoanBalanceReportExcel?Qtype=1&Center=0';
            }
            window.open(url);

        }

        function Pdf() {
            var url;
            var center = $("#ddlCenter").val();
            if (center > 0) {
                url = '/LoanSavingLedger/GenerateLoanBalanceReportPDF?Qtype=2&Center=' + center;
            }
            else if (center == 0) {
                url = '/LoanSavingLedger/GenerateLoanBalanceReportPDF?Qtype=1&Center=0';
            }
            window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
        }      
       
    });
</script>
<h2 class="page-title">Loan Balance</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="">
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Select Center", new { @class = "control-label" })
                    @Html.DropDownList("CenterList", null, new { @ID = "ddlCenter", @class = "form-control" })
                </div>
            </div>
            <div class="col-md-8">&nbsp;</div>
        </div>
        <h2 class="page-title"></h2>
        <div class="row">
            <div class="col-md-4">
                @Html.Label("Export Type", htmlAttributes: new { @class = "control-label" })

                @Html.DropDownList("ddlExportType", new List<SelectListItem> {
                    new SelectListItem { Text = "PDF", Value = "pdf", Selected = true },
                    new SelectListItem { Text = "Excel", Value = "excel" }
                }, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group from-action">
                    <input type="submit" value="View" class="btn btn-primary" id="btnView" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}



