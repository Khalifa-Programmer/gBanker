
@{
    ViewBag.Title = "Overdue List";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<script type="text/javascript">
    function GetHO(ddlVal) {
        console.log('getho-8' + ddlVal);
        var ddlHO = $("#ddlHO");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetHOList", "OverdueMemberList", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlHO.html('');
                $.each(data, function (id, option) {
                    ddlHO.append($('<option></option>').val(option.Value).html(option.Text));
                });
                if (ddlVal != null) {
                    $('#ddlHO').val(ddlVal);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function GetZone(HO_val, ddlVal) {
        console.log('getzone-30' + HO_val + ddlVal);
        var ddlZone = $("#ddlZone");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetZoneList_multiple", "OverdueMemberList", "http")',
            data: { HO_val: HO_val },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlZone.html('');
                $.each(data, function (id, option) {
                    ddlZone.append($('<option></option>').val(option.Value).html(option.Text));
                });
                if (ddlVal != null) {
                    $('#ddlZone').val(ddlVal);
                }
                ddlZone.selectpicker('refresh');
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function GetArea(HO_val, zone_val, ddlVal) {
        console.log('getarea-55' + HO_val + zone_val + ddlVal);
        var ddlArea = $("#ddlArea");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetAreaList_multiple", "OverdueMemberList", "http")',
            data: { HO_val: HO_val, zone_val: zone_val },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlArea.html('');
                $.each(data, function (id, option) {
                    ddlArea.append($('<option></option>').val(option.Value).html(option.Text));
                });
                if (ddlVal != null) {
                    $('#ddlArea').val(ddlVal);
                }
                ddlArea.selectpicker('refresh');
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetOffice(HO_val, zone_val, area_val, ddlVal) {
        console.log('GetOffice-82' + HO_val + zone_val + area_val + ddlVal);
        var ddlOffice = $("#ddlOffice");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetOfficeList_multiple", "OverdueMemberList", "http")',
            data: { HO_val: HO_val, zone_val: zone_val, area_val: area_val },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlOffice.html('');

                $.each(data, function (id, option) {
                    ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                });

                if (ddlVal != null) {
                    $('#ddlOffice').val(ddlVal);
                }
                ddlOffice.selectpicker('refresh');
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetEmployee(ddlVal) {
        
        if (ddlVal != '') {
                var ddlEmployee = $("#ddlEmployee");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetEmployeeList_multiple", "OverdueMemberList", "http")',
                    data: { office_val: ddlVal },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlEmployee.html('');
                        $.each(data, function (id, option) {
                            ddlEmployee.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        ddlEmployee.selectpicker('refresh');
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            } else {
               // $("#ddlOffice").empty();
            }
    }

    function CheckOffcLevel() {
        var offcLevel = $('#lblOffcLevel').html();
        var firstLevel = $('#lblFirstLevel').html();
        var secondLevel = $('#lblSecondLevel').html();
        var thirdLevel = $('#lblThirdLevel').html();
        var fourthLevel = $('#lblFourthLevel').html();

        console.log('checkofficelevel 114' + offcLevel);

        if (offcLevel == 1) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            $("#ddlArea").html("<option value=''>Please Select</option>");
            $("#ddlOffice").html("<option value=''>Please Select</option>");
            $("#ddlHO").prop("disabled", true);
        }
        if (offcLevel == 2) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            GetArea(firstLevel, secondLevel, null);
            $("#ddlHO").prop("disabled", true);
            $("#ddlZone").prop("disabled", true);
            $("#ddlOffice").html("<option value=''>Please Select</option>");
        }
        if (offcLevel == 3) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            GetArea(firstLevel, secondLevel, thirdLevel);
            GetOffice(firstLevel, secondLevel, thirdLevel, null);
            $("#ddlHO").prop("disabled", true);
            $("#ddlZone").prop("disabled", true);
            $("#ddlArea").prop("disabled", true);
        }
        if (offcLevel == 4) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            GetArea(firstLevel, secondLevel, thirdLevel);
            GetOffice(firstLevel, secondLevel, thirdLevel, fourthLevel);
            GetEmployee(fourthLevel);
            $("#ddlHO").prop("disabled", true);
            $("#ddlZone").prop("disabled", true);
            $("#ddlArea").prop("disabled", true);
            $("#ddlOffice").prop("disabled", true);
        }
    }

    function YearList() {
                var ddlYear = $("#ddlYear");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetYearList", "OverdueMemberList", "http")',
                    dataType: 'json',
                    async: true,
                    success: function (data) {

                        ddlYear.html('');
                        $.each(data, function (id, option) {
                            ddlYear.append($('<option></option>').val(option.Value).html(option.Text));
                        });

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
    }

    function MonthList() {
            var ddlMonth = $("#ddlMonth");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetMonthList", "OverdueMemberList", "http")',
                    dataType: 'json',
                    async: true,
                    success: function (data) {

                        ddlMonth.html('');
                        $.each(data, function (id, option) {
                            ddlMonth.append($('<option></option>').val(option.Value).html(option.Text));
                        });

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
    }

