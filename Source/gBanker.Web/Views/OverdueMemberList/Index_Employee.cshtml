            window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
        });
        $('#btnExport').click(function () {
            var month = $("#ddlMonth").val();
            var year = $("#ddlYear").val();
            var employee = $("#ddlEmployee").val();

            var Qtype;
            var office_id;

            if ($("#ddlHO").val() > 0) {
