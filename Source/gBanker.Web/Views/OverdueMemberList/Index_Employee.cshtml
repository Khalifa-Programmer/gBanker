        $("#btnView").click(function (e) {
            e.preventDefault();

            var month = $("#ddlMonth").val();
            var year = $("#ddlYear").val();
            var employee = $("#ddlEmployee").val();

            var Qtype;
            var office_id;

            if ($("#ddlHO").val() > 0) {
                office_id = $("#ddlHO").val();
