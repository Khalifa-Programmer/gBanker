            }
            var url = '/OverdueMemberList/GenerateOverdueMemberListNewtReportExport_Employee?Qtype=' + Qtype + '&OfficeId=' + office_id + '&Month=' + month + '&Year=' + year + '&Employee=' + employee;
            window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');

        });



    });

</script>



