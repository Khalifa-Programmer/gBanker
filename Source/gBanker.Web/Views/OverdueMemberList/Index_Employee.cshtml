                            ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        ddlOffice.selectpicker('refresh');
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            } else {
               // $("#ddlOffice").empty();
            }
        });


        $("#ddlOffice").change(function () {
            var office_val = $("#ddlOffice").val();
            console.log('office_val ' + office_val);

            // Convert the array of selected values to a comma-separated string
            var office_val_str = office_val ? office_val.join(",") : "";

            if ( office_val_str != '') {
                var ddlEmployee = $("#ddlEmployee");
                $.ajax({
                    type: 'GET',
