
@model gBanker.Web.ViewModels.MemberWisePassbookBalanceEntryViewModel

@{
    ViewBag.Title = "Product Employment Add";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";

    var productlist = Model == null ? null : Model.ProductList;
    var centerListItems = Model == null ? null : Model.centerListItems;
    var officeListItems = Model == null ? null : Model.officeListItems;


}
<script type="text/javascript">

    $(document).ready(function () {
        $("#MainProductCode").change(function () {
            var selectedText = $("#MainProductCode option:selected").text();
            $("#MainProductName").val(selectedText);
        });


        $("#btnCreate").click(function (e) {

            //Form Data
            var model = {
                'MemberWisePassbookBalanceEntryId': $('#MemberWisePassbookBalanceEntryId').val(),
                'OfficeID': $('#OfficeId').val(),
                'CenterID': $('#CenterId').val(),
                'MemberID': $('#MemberId').val(),
                'ProductID': $('#ProductId').val(),
                'Amount': $('#Amount').val(),
            }

            $.ajax({
                url: "/MemberWisePassbookBalanceEntry/CreateEntry",
                type: "POST",
                async: true,
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: model,
                success: function (data) {
                    $.alert.open(data);
                    employeeProdApp.reloadGrid();
                }
            });

        });

    });

</script>
@Html.ActionLink("Back to List", "Create", null, new { @class = "pull-right" })
<h2 class="page-title">MemberWise Passbook Balance Entry</h2>

