@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-info btn-sm pull-right" })
<h2 class="page-title">Inter Branch Transaction Collection List</h2>

<div class="row">
    <div class="col-md-1 text-right">
        <label class="control-label" style="padding-top: 8px; padding-right:3px;">Type:</label>
    </div>
<div class="col-md-2">
        <select id="CheckingToolType" name="CheckingToolType" class="form-control">
            <option value=0>Select One</option>
            <option value=1>Loan</option>
            <option value=2>Savings</option>
        </select>
    </div>
    <div class="col-md-1 text-right">
        <label class="control-label" style="padding-top:8px;">Filter By:</label>
    </div>
    <div class="col-md-2">

        <select id="filterColumn" class="form-control">
            <option value="">View All</option>
            <option value="CenterCode">Samity Code</option>
            <option value="MemberCode">Member Code</option>
            <option value="ProductCode">Product Code</option>
            <option value="Transtype">Transaction Type</option>
        </select>
    </div>
    <div class="col-md-3">
        <input type="text" id="filterValue" placeholder="Type Search Text" class="form-control" />
    </div>
    <div class="col-md-3">
        <input type="button" id="btnSearch" value="Search" onclick="reloadGrid();" class="btn btn-primary" />
    </div>
</div>



<div class="table-responsive">
    <div style="display: none;" id="grid1"></div>
    <div style="display: none;" id="grid2"></div>
</div>
<br />
@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}


