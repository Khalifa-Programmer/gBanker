                $("span[data-valmsg-for='PhoneNo']").text('Warning! Mobile No Must be 11 Digits');
                $("span[data-valmsg-for='PhoneNo']").show();
                return;
            }

            let inputedValue = $(this).val();

            let inputedValues = inputedValue.slice(0, 3);
            if (inputedValues && inputedValues.length > 0) {

                let nameContainsWith = false;
                let isExists = _.some(ValidMobileOperatorBD, ['nameWithStart', _.toUpper(inputedValues)]);
                if (isExists) {
                    nameContainsWith = true;
                }
                //if not found any then show notification
