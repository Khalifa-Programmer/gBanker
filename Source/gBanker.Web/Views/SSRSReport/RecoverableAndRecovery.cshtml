@using gBanker.Web.Helpers;
@model gBanker.Web.ViewModels.MemberViewModel


@{
    ViewBag.Title = "RecoverableAndRecovery";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var cntr = Model == null ? null : Model.CenterList;
    var OrgId = SessionHelper.LoginUserOrganizationID ;

}


<script type="text/javascript">

    function GetHO(ddlVal) {
        var ddlHO = $("#ddlHO");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetHOList", "AccLedgerReport", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlHO.html('');
                $.each(data, function (id, option) {
                    ddlHO.append($('<option></option>').val(option.Value).html(option.Text));
                });
                if (ddlVal != null) {
                    $('#ddlHO').val(ddlVal);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function GetZone(HO_val, ddlVal) {
        var ddlZone = $("#ddlZone");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetZoneList", "AccBalanceSheet", "http")',
            data: { HO_val: HO_val },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlZone.html('');
                $.each(data, function (id, option) {
                    ddlZone.append($('<option></option>').val(option.Value).html(option.Text));
                });
                if (ddlVal != null) {
                    $('#ddlZone').val(ddlVal);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function GetArea(HO_val, zone_val, ddlVal) {
        var ddlArea = $("#ddlArea");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetAreaList", "AccBalanceSheet", "http")',
            data: { HO_val: HO_val, zone_val: zone_val },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlArea.html('');
                $.each(data, function (id, option) {
                    ddlArea.append($('<option></option>').val(option.Value).html(option.Text));
                });
                if (ddlVal != null) {
                    $('#ddlArea').val(ddlVal);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetOffice(HO_val, zone_val, area_val, ddlVal) {
        var ddlOffice = $("#ddlOffice");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetOfficeList", "AccBalanceSheet", "http")',
            data: { HO_val: HO_val, zone_val: zone_val, area_val: area_val },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlOffice.html('');

                $.each(data, function (id, option) {
                    ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                });

                if (ddlVal != null) {
                    $('#ddlOffice').val(ddlVal);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function CheckOffcLevel() {
        var offcLevel = $('#lblOffcLevel').html();
        var firstLevel = $('#lblFirstLevel').html();
        var secondLevel = $('#lblSecondLevel').html();
        var thirdLevel = $('#lblThirdLevel').html();
        var fourthLevel = $('#lblFourthLevel').html();

        if (offcLevel == 1) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            $("#ddlArea").html("<option value=''>Please Select</option>");
            $("#ddlOffice").html("<option value=''>Please Select</option>");
            $("#ddlHO").prop("disabled", true);
        }
        if (offcLevel == 2) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            GetArea(firstLevel, secondLevel, null);
            $("#ddlHO").prop("disabled", true);
            $("#ddlZone").prop("disabled", true);
            $("#ddlOffice").html("<option value=''>Please Select</option>");
        }
        if (offcLevel == 3) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            GetArea(firstLevel, secondLevel, thirdLevel);
            GetOffice(firstLevel, secondLevel, thirdLevel, null);
            $("#ddlHO").prop("disabled", true);
            $("#ddlZone").prop("disabled", true);
            $("#ddlArea").prop("disabled", true);
        }
        if (offcLevel == 4) {
            GetHO(firstLevel);
            GetZone(firstLevel, secondLevel);
            GetArea(firstLevel, secondLevel, thirdLevel);
            GetOffice(firstLevel, secondLevel, thirdLevel, fourthLevel);
            $("#ddlHO").prop("disabled", true);
            $("#ddlZone").prop("disabled", true);
            $("#ddlArea").prop("disabled", true);
            $("#ddlOffice").prop("disabled", true);
        }
    }

    function ZoneAreaShowHide() {
    $.ajax({
        type: 'GET',
        contentType: "application/json; charset=utf-8",
        url: '@Url.Action("ZoneAreaShowHide", "SSRSReport")',
        dataType: 'json',
        async: true,
        success: function (data) {
            $.each(data, function (index, option) {
                // SHOW ZONE AREA ONLY FOR ORG 190
                $("#" + option.Value).css('display', option.Text);
                if (option.Text == 'block')
                    $('#OrgReco').val('190');
                else
                    $('#OrgReco').val('0');
            });
        },
        error: function (request, status, error) {
            alert(request.statusText + "/" + request.statusText + "/" + error);
        }
    });
   }


    function LoadCenterByOfficeId(office_id) {
        var ddlCenters = $("#CenterID2");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCenterList_Custom", "SSRSReport", "http")',
            data: { office_id: office_id },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlCenters.html('');
                $.each(data, function (id, option) {
                    ddlCenters.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.status + "/" + error);
            }
        });
    }




    $(document).ready(function () {
        ZoneAreaShowHide();
        LoadCenterByOfficeId($("#OfficeID").val());
        CheckOffcLevel();
       // $(".centerdiv").hide();
        $("#ddlQtype").change(function (e) {
            var ddlQtype = $("#ddlQtype option:selected").val();
            if (ddlQtype == 2) {
                $(".centerdiv").show();
            } else {
                $(".centerdiv").hide();
            }
        });

        $("#txtFromDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });
        $("#txtToDt").datepicker(
            {
                dateFormat: "dd-M-yy",
                showAnim: "scale"
            });


        $("#ddlHO").change(function () {
            var HO_val = $("#ddlHO").val();
            if (HO_val > 0) {
                var ddlZone = $("#ddlZone");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetZoneList", "AccLedgerReport", "http")',
                    data: { HO_val: HO_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlZone.html('');
                        $.each(data, function (id, option) {
                            ddlZone.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlZone").empty();
                $("#ddlArea").empty();
                $("#ddlOffice").empty();
            }
        });

        $("#ddlZone").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            if (HO_val > 0 && zone_val > 0) {
                var ddlArea = $("#ddlArea");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetAreaList", "AccLedgerReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlArea.html('');
                        $.each(data, function (id, option) {
                            ddlArea.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                        $("#ddlOffice").empty();
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlArea").empty();
                $("#ddlOffice").empty();
            }
        });

        $("#ddlArea").change(function () {
            var HO_val = $("#ddlHO").val();
            var zone_val = $("#ddlZone").val();
            var area_val = $("#ddlArea").val();
            if (HO_val > 0 && zone_val > 0 && area_val !="0") {
                var ddlOffice = $("#ddlOffice");
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetOfficeList", "AccLedgerReport", "http")',
                    data: { HO_val: HO_val, zone_val: zone_val, area_val: area_val },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        ddlOffice.html('');
                        $.each(data, function (id, option) {
                            ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
            else {
                $("#ddlOffice").empty();
            }
        });


        $("#btnView").click(function (e) {
            e.preventDefault();
            var DateFrom = $("#txtFromDt").val();
            var DateTo = $("#txtToDt").val();

            var Qtype;
            var office_id;

            var DateTo = $("#txtToDt").val();

            if ($("#ddlHO").val() > 0) {
                office_id = $("#ddlHO").val();
                Qtype = 1;
                if ($("#rdDivision").prop('checked')) {
                    if ($("#ddlProgram").val()) {
                        Qtype = 7;
                        office_id = $("#ddlProgram").val();
                    }
                    else if ($("#ddlDivision").val()) {
                        Qtype = 6;
                        office_id = $("#ddlDivision").val();
                    }
                }
                else {
                    if ($("#ddlZone").val() > 0) {
                        Qtype = 2;
                        if ($("#ddlArea").val() > 0) {
                            Qtype = 3;
                            if ($("#ddlOffice").val() > 0) {
                                Qtype = 4;
                                office_id = $("#ddlOffice").val();
                            }
                            else {
                                office_id = $("#ddlArea").val();
                            }
                        }
                        else {
                            office_id = $("#ddlZone").val();
                        }
                    }
                    else {
                        office_id = $("#ddlZone").val();
                    }
                }

                var CenterID = $('#CenterID2').val();

                var system = '@OrgId';
                console.log(system);
                var OrgReco = $('#OrgReco').val();
                var url = '';

                if (OrgReco == "0")
                    url = '/SSRSReport/GetRecoverableAndRecoveryDateWise?DateFrom=' + DateFrom + '&DateTo=' + DateTo;
                else
                    if (system == "190")
                        url = '/SSRSReport/GetRecoverableAndRecoveryDateWise_Area_Zone_Wise_Center?Qtype=' + Qtype + '&OfficeId=' + office_id + '&DateFrom=' + DateFrom + '&DateTo=' + DateTo + '&CenterId=' + CenterID;
                    else
                         url = '/SSRSReport/GetRecoverableAndRecoveryDateWise_Area_Zone_Wise?Qtype=' + Qtype + '&OfficeId=' + office_id + '&DateFrom=' + DateFrom + '&DateTo=' + DateTo;


                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');


            }



        });



        $("#txtToDt").change(function (e) {
            e.preventDefault();
            process_view();
        });
    });


</script>
<h2 class="page-title">Recoverable And Recovery Report</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="">

        <input type="hidden" id="OrgReco" value="0" />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Date From", new { @class = "control-label" })
                    @Html.TextBox(" ", ViewData["Trxdate"].ToString(), new { @ID = "txtFromDt", @class = "form-control" })
                    @*@Html.TextBox(" ", "", new { @ID = "txtFromDt", @class = "form-control" })*@
                </div>
            </div>
            <div class="col-md-8">&nbsp;</div>
        </div>


        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Date To", new { @class = "control-label" })
                    @Html.TextBox(" ", ViewData["Trxdate"].ToString(), new { @ID = "txtToDt", @class = "form-control" })
                    @*@Html.TextBox(" ", "", new { @ID = "txtToDt", @class = "form-control" })*@
                </div>
            </div>
            <div class="col-md-8">&nbsp;</div>
        </div>

        <div class="row">
            <div class="col-md-4" style="display:none;">
                <div class="form-group">
                    @Html.Label("Head Office", new { @class = "control-label" })
                    @Html.DropDownList("HOList", null, new { @ID = "ddlHO", @class = "form-control" })
                    @Html.Label(ViewData["OfficeLevel"].ToString(), new { @ID = "lblOffcLevel", style = "display:none;" })
                    @Html.Label(ViewData["FirstLevel"].ToString(), new { @ID = "lblFirstLevel", style = "display:none;" })
                    @Html.Label(ViewData["SecondLevel"].ToString(), new { @ID = "lblSecondLevel", style = "display:none;" })
                    @Html.Label(ViewData["ThirdLevel"].ToString(), new { @ID = "lblThirdLevel", style = "display:none;" })
                    @Html.Label(ViewData["FourthLevel"].ToString(), new { @ID = "lblFourthLevel", style = "display:none;" })
                </div>
            </div>
        </div>
        <div class="row" id="_div_zone" style="display:none;">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Zone Office", new { @class = "control-label" })
                    @Html.DropDownList("ZoneList", null, new { @ID = "ddlZone", @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="row" id="_div_area" style="display:none;">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Area Office", new { @class = "control-label" })
                    @Html.DropDownList("AreaList", null, new { @ID = "ddlArea", @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="row" id="_div_office" style="display:none;">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Office", new { @class = "control-label" })
                    @Html.DropDownList("OfficeList", null, new { @ID = "ddlOffice", @class = "form-control" })
                </div>
            </div>
        </div>



        <div class="row" style="display:none;">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Report", new { @class = "control-label" })
                    @Html.DropDownList("QtypeList", new[] {
                       new SelectListItem() {Text="CenterWise", Value="1",Selected = true},
                       new SelectListItem() {Text="LoaneeWise", Value="2"},
                       new SelectListItem() {Text="ProductWise", Value="3"},
                       },
                       new { @ID = "ddlQtype", @class = "form-control" })
                </div>
            </div>
            <div class="col-md-8">&nbsp;</div>
        </div>


        <div class="row centerdiv" id="_div_center" style="display: none;">
            <div class="col-md-4">
                <div class="form-group">

                    @*@Html.Label("Program", new { @class = "control-label" })
                    @Html.DropDownList("ProgramList", new[] {
                         new SelectListItem() {Text="Select", Value="0",Selected = true},
                         new SelectListItem() {Text="Unnoti", Value="1"},
                         new SelectListItem() {Text="Udayan", Value="2"},
                         },
                         new { @ID = "ddlQtype", @class = "form-control" })*@


                    @Html.LabelFor(model => model.CenterID2, htmlAttributes: new { @class = "control-label" })<span style="color:red; font-size:15px;"> * </span>
        @Html.DropDownListFor(model => model.CenterID2, cntr, new { @class = "form-control" })
        @Html.HiddenFor(model => model.OfficeID)
        @Html.ValidationMessageFor(model => model.CenterID2, "", new { @class = "text-danger" })
               
                </div>
            </div>
        </div>


        <h2 class="page-title"></h2>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group from-action">
                    <input type="submit" value="View" class="btn btn-primary" id="btnView" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}
